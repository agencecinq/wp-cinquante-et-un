{
  "$schema": "https://blockstudio.dev/schema/block",
  "name": "wp-cinquante-et-un/cta",
  "title": "CTA",
  "category": "design",
  "icon": "megaphone",
  "description": "Centered closing call to action. Prefer the inverse color scheme.",
  "keywords": ["cta", "call to action", "cinq"],
  "supports": {
    "anchor": true,
    "align": false,
    "customClassName": false
  },
  "blockstudio": {
    "attributes": [
      {
        "id": "tabs",
        "type": "tabs",
        "tabs": [
          {
            "id": "content",
            "title": "Content",
            "attributes": [
              {
                "id": "title",
                "type": "text",
                "label": "Title"
              },
              {
                "id": "text",
                "type": "textarea",
                "label": "Text",
                "help": "Optional supporting copy."
              },
              {
                "id": "cta_primary",
                "type": "link",
                "label": "Primary link",
                "opensInNewTab": true
              },
              {
                "id": "cta_secondary",
                "type": "link",
                "label": "Secondary link",
                "opensInNewTab": true,
                "help": "Optional."
              }
            ]
          },
          {
            "id": "settings",
            "title": "Settings",
            "attributes": [
              {
                "id": "color_scheme",
                "type": "select",
                "label": "Color scheme",
                "default": "inverse",
                "options": [
                  { "value": "default", "label": "Default" },
                  { "value": "inverse", "label": "Inverse" }
                ]
              },
              {
                "id": "spacing_top",
                "type": "select",
                "label": "Spacing top",
                "default": "md",
                "options": [
                  { "value": "none", "label": "None" },
                  { "value": "sm", "label": "Small" },
                  { "value": "md", "label": "Medium" },
                  { "value": "lg", "label": "Large" },
                  { "value": "xl", "label": "Extra large" }
                ]
              },
              {
                "id": "spacing_bottom",
                "type": "select",
                "label": "Spacing bottom",
                "default": "md",
                "options": [
                  { "value": "none", "label": "None" },
                  { "value": "sm", "label": "Small" },
                  { "value": "md", "label": "Medium" },
                  { "value": "lg", "label": "Large" },
                  { "value": "xl", "label": "Extra large" }
                ]
              },
              {
                "id": "container",
                "type": "select",
                "label": "Container",
                "default": "default",
                "options": [
                  { "value": "default", "label": "Default" },
                  { "value": "wide", "label": "Wide" },
                  { "value": "full", "label": "Full" }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
