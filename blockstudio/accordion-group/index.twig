{#
 # Blockstudio: Accordion Group (FAQ)
 # Pilot: @agencecinq/accordion (CINQ UI) — same markup as the styleguide.
 #}
{%- set layout = {
	color_scheme: a.color_scheme | default('default'),
	spacing_top: a.spacing_top | default('md'),
	spacing_bottom: a.spacing_bottom | default('md'),
	container: a.container | default('default')
} -%}
{%- set items = a.items | default([]) -%}
{%- set uid = uniqid('faq-') -%}
{%- set faq_schema_json = a.schema and items | length ? fn('cinq_faq_schema_json', items) : '' -%}

{%- if items | length -%}
	<section
		useBlockProps
		class="{{ fn('cinq_block_layout_classes', layout) }}"
		data-color-scheme="{{ fn('cinq_block_color_scheme', layout) }}"
	>
		<div class="{{ html_classes( fn('cinq_block_container_classes', layout) | default('container'), 'grid grid-cols-12 items-start gap-x-8 gap-y-10' ) }}">
			<div class="col-span-full space-y-3 lg:sticky lg:top-24 lg:col-span-4">
				{{- include('components/subtitle.html.twig', { title: a.overline }, with_context = false) -}}

				{%- if a.title -%}
					<h2 class="text-2xl font-semibold">{{- a.title | e -}}</h2>
				{%- endif -%}
			</div>

			<div class="col-span-full lg:col-span-7 lg:col-start-6">
				<cinq-accordion class="block border-t border-gray-200" data-hash="false">
					{%- for item in items -%}
						{%- set panel_id = uid ~ '-' ~ loop.index -%}
						{%- set is_open = loop.first -%}
						<div
							class="border-b border-gray-200 py-6 data-[open=true]:flex data-[open=true]:flex-col data-[open=true]:gap-4"
							data-panel
							data-open="{{ is_open ? 'true' : 'false' }}"
							data-deselect="true"
						>
							<button
								type="button"
								class="flex w-full cursor-pointer items-center justify-between gap-4 text-left text-sm font-semibold"
								data-header
								id="{{ panel_id }}-header"
								aria-expanded="{{ is_open ? 'true' : 'false' }}"
								aria-controls="{{ panel_id }}-body"
							>
								<span class="min-w-0 flex-1">{{- item.question | e -}}</span>
								<span
									class="relative flex size-8 shrink-0 items-center justify-center bg-gray-100"
									aria-hidden="true"
								>
									<span class="in-data-[open=true]:hidden">
										<svg class="size-3 fill-current" viewBox="0 0 24 24" focusable="false">
											<path d="M11 5h2v14h-2zM5 11h14v2H5z"/>
										</svg>
									</span>
									<span class="hidden in-data-[open=true]:block">
										<svg class="size-3 fill-current" viewBox="0 0 24 24" focusable="false">
											<path d="M5 11h14v2H5z"/>
										</svg>
									</span>
								</span>
							</button>
							<div
								id="{{ panel_id }}-body"
								role="region"
								aria-labelledby="{{ panel_id }}-header"
								{% if not is_open %}hidden{% endif %}
							>
								<div class="wysiwyg max-w-3xl text-sm" data-inner>
									{{- item.answer | raw -}}
								</div>
							</div>
						</div>
					{%- endfor -%}
				</cinq-accordion>
			</div>
		</div>

		{%- if faq_schema_json -%}
			<script type="application/ld+json">
				{{- faq_schema_json | raw -}}
			</script>
		{%- endif -%}
	</section>
{%- endif -%}
