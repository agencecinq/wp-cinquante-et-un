 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}
<!DOCTYPE html>

<html
	itemscope
	itemtype="http://schema.org/WebPage"
	{{ html_class('no-js no-touch antialiased') }}
	{{ site.language_attributes }}
>
	<head>
		<meta charset="{{ site.charset }}" />
		<link rel="profile" href="http://gmpg.org/xfn/11" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{{ function('wp_head') }}
	</head>

	<body {{ body_class('text-zinc-950 bg-white antialiased') }}>
		{{- function('wp_body_open ') -}}

		{%- block header -%}
			{{- include('header.html.twig') -}}
		{%- endblock -%}

		{%- block content -%}
			<main id="content" role="main">
				<div class="container space-y-5 pt-5 pb-20 lg:space-y-20 lg:pt-12.5">
					<h1 class="text-4xl font-medium tracking-tight text-zinc-950 lg:text-6xl">
						{{- post.title -}}
					</h1>
				</div>

				{%- if post.content -%}
					<div class="container grid grid-cols-12 gap-5 pt-26.25 pb-20 lg:pt-32.5">
						<div class="wysiwyg col-span-full lg:col-span-6 lg:col-start-4">
							{{- post.content -}}
						</div>
					</div>
				{%- endif -%}

				{{-
					include(
						'blocks/blocks.html.twig',
						{
							blocks: post.meta('blocks')
						}
					)
				-}}
			</main>
		{%- endblock -%}

		{%- block footer -%}
			{{- include('footer.html.twig') -}}
		{%- endblock -%}

		{{- function('wp_footer') -}}

		<div id="svg-sprite" style="display: none;">
			{{- include('public/sprite.svg', ignore_missing = true) -}}
		</div>
	</body>
</html>
