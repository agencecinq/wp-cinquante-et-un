 # Index
 #
 # @package WPCinquanteEtUn
 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}
<!DOCTYPE html>

<html
	itemscope
	itemtype="http://schema.org/WebPage"
	{{ html_class('no-js no-touch antialiased') }}
	{{ site.language_attributes }}
>
	<head>
		<meta charset="{{ site.charset }}" />
		<link rel="profile" href="http://gmpg.org/xfn/11" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{{ function('wp_head') }}
	</head>

	<body {{ body_class('bg-white pt-22 text-black antialiased') }}>
		{{- function('wp_body_open ') -}}

		{%- block header -%}
			{{- include('header.html.twig') -}}
		{%- endblock -%}

		{%- block content -%}
			<main id="content" role="main">
				{%- set blocks = post.meta('blocks') -%}
				{%- set show_page_header = post.title and (blocks | length == 0 or blocks[0].acf_fc_layout != 'hero') -%}

				{%- if show_page_header -%}
					{{-
						include(
							'components/page-header.html.twig',
							{
								post: post
							}
						)
					-}}
				{%- endif -%}

				{{-
					include(
						'blocks/blocks.html.twig',
						{
							blocks: blocks
						}
					)
				-}}
			</main>
		{%- endblock -%}

		{%- block footer -%}
			{{- include('footer.html.twig') -}}
		{%- endblock -%}

		{{- function('wp_footer') -}}

		<div id="svg-sprite" style="display: none;">
			{{- include('public/sprite.svg', ignore_missing = true) -}}
		</div>
	</body>
</html>
