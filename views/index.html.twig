{#
 # Index
 #
 # @package WPCinquanteEtUn
 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}
<!DOCTYPE html>

<html
	itemscope
	itemtype="http://schema.org/WebPage"
	{{ html_class('antialiased') }}
	{{ site.language_attributes }}
>
	<head>
		<meta charset="{{ site.charset }}" />
		<link rel="profile" href="http://gmpg.org/xfn/11" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{{ function('wp_head') }}
	</head>

	<body {{ body_class('bg-white pt-22 text-black antialiased') }}>
		{{- function('wp_body_open ') -}}

		{%- block header -%}
			{{- include('header.html.twig') -}}
		{%- endblock -%}

		{%- block content -%}
			<main id="content" role="main">
				{%- set acf_blocks = post.meta('blocks') | default([]) -%}
				{%- set has_acf_hero = acf_blocks | length > 0 and acf_blocks[0].acf_fc_layout == 'hero' -%}
				{%- set has_bs_hero = function('has_block', 'wp-cinquante-et-un/hero', post.id) -%}
				{%- set has_gutenberg = function('has_blocks', post.content) -%}

				{%- if not has_acf_hero and not has_bs_hero -%}
					{{-
						include(
							'components/page-header.html.twig',
							{
								post: post
							}
						)
					-}}
				{%- endif -%}

				{%- if post.content -%}
					
						<div class="container pb-section-lg">
							
								{{- post.content -}}
							
						</div>
					
				{%- endif -%}

				{# ACF flexible content kept during the dual-run experiment. #}
				{{-
					include(
						'blocks/blocks.html.twig',
						{
							blocks: acf_blocks
						}
					)
				-}}
			</main>
		{%- endblock -%}

		{%- block footer -%}
			{{- include('footer.html.twig') -}}
		{%- endblock -%}

		{{- function('wp_footer') -}}

		<div id="svg-sprite" style="display: none;">
			{{- include('public/sprite.svg', ignore_missing = true) -}}
		</div>
	</body>
</html>
