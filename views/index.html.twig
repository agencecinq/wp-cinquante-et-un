 # Index
 #
 # @package WPCinquanteEtUn
 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}
<!DOCTYPE html>

<html
	itemscope
	itemtype="http://schema.org/WebPage"
	{{ html_class('no-js no-touch antialiased') }}
	{{ site.language_attributes }}
>
	<head>
		<meta charset="{{ site.charset }}" />
		<link rel="profile" href="http://gmpg.org/xfn/11" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{{ function('wp_head') }}
	</head>

	<body {{ body_class('text-zinc-950 bg-white antialiased') }}>
		{{- function('wp_body_open ') -}}

		{%- block header -%}
			{{- include('header.html.twig') -}}
		{%- endblock -%}

		{%- block content -%}
			<main id="content" role="main">
				<div class="container space-y-10 py-10 lg:py-20">
					{%- if post.title -%}
						<header class="space-y-3">
							<h1 class="text-4xl font-medium tracking-tight lg:text-6xl">{{- post.title -}}</h1>
						</header>
					{%- endif -%}

					{%- if post.post_content -%}
						<div class="wysiwyg max-w-prose">
							{{- post.content -}}
						</div>
					{%- endif -%}
				</div>

				{{-
					include(
						'blocks/blocks.html.twig',
						{
							blocks: post.meta('blocks')
						}
					)
				-}}
			</main>
		{%- endblock -%}

		{%- block footer -%}
			{{- include('footer.html.twig') -}}
		{%- endblock -%}

		{{- function('wp_footer') -}}

		<div id="svg-sprite" style="display: none;">
			{{- include('public/sprite.svg', ignore_missing = true) -}}
		</div>
	</body>
</html>
