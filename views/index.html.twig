{#
 # Index
 #
 # @package WPCinquanteEtUn
 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}
<!DOCTYPE html>

<html
	itemscope
	itemtype="http://schema.org/WebPage"
	{{ html_class( 'antialiased' ) }}
	{{ site.language_attributes }}
>
	<head>
		<meta charset="{{ site.charset }}" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{{ function( 'wp_head' ) }}
	</head>

	<body {{ body_class( 'bg-page pt-22 text-primary antialiased' ) }}>
		{{- function( 'wp_body_open ' ) -}}

		{%- block header -%}
			{{- include( 'header.html.twig' ) -}}
		{%- endblock -%}

		{%- block content -%}
			<main id="content" role="main">
				{%- if
					( post.meta( 'blocks' ) | length ) == 0
						or post.meta( 'blocks' )[0].acf_fc_layout != 'hero' -%}
					{{- include( 'components/page-header.html.twig', { post: post } ) -}}
				{%- endif -%}

				{%- if post.content -%}
					<section class="container pb-14 lg:pb-24">
						<div class="wysiwyg max-w-prose">
							{{- post.content -}}
						</div>
					</section>
				{%- endif -%}

				{{- include( 'blocks/blocks.html.twig', { blocks: post.meta( 'blocks' ) } ) -}}
			</main>
		{%- endblock -%}

		{%- block footer -%}
			{{- include( 'footer.html.twig' ) -}}
		{%- endblock -%}

		{{- function( 'wp_footer' ) -}}

		<div id="svg-sprite" style="display: none;">
			{{- include( 'public/sprite.svg', ignore_missing: true ) -}}
		</div>
	</body>
</html>
