{#
 # Header
 #
 # Sticky 64px bar: logo, main nav (desktop), contact CTA, mobile drawer.
 #
 # @package WPCinquanteEtUn
 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}

<header
	role="banner"
	itemscope
	itemtype="https://schema.org/WPHeader"
	class="{{
	html_classes(
		'sticky top-0 z-10 h-16 border-b border-zinc-200 bg-white/85 backdrop-blur-[0.875rem]',
		classes | default([]) | join(' ')
	)
	}}"
>
	<div class="container flex h-full items-center justify-between gap-4">
		<a href="{{ site.link }}" class="shrink-0" aria-label="{{ site.name }}">
			<img
				class="block h-4.75 w-16"
				src="{{ asset('src/img/svg/logo.svg') }}"
				alt="{{ site.name }}"
				width="64"
				height="19"
			/>
		</a>

		{%- if nav_menus.main -%}
			<nav aria-label="{{ __('Main navigation', 'wp-cinquante-et-un') }}" class="hidden lg:block">
				<ul class="flex gap-8 font-mono text-xs tracking-widest">
					{%- for item in nav_menus.main.get_items() -%}
						<li itemscope itemtype="https://schema.org/SiteNavigationElement">
							<a
								href="{{ item.url }}"
								itemprop="url"
								class="{{
								html_classes(
									item.current
										or 'current-menu-parent' in item.classes
										or 'current-page-ancestor' in item.classes
										? ''
										: 'text-zinc-500 hover:text-zinc-950',
									item.classes | default([]) | join(' ')
								)
								}}"
								{{ item.children | length ? 'aria-haspopup="true"' }}
								{{
								item.is_target_blank or item.is_external
									? 'target="' ~ item.target ~ '" rel="noopener noreferrer"'
								}}
							>
								<span itemprop="name">{{- item.title -}}</span>
							</a>
						</li>
					{%- endfor -%}
				</ul>
			</nav>
		{%- endif -%}

		{%- if theme.contact.link.url or nav_menus.main -%}
			<div class="flex items-center gap-4">
				{%- if theme.contact.link.url -%}
					<a
						href="{{ theme.contact.link.url }}"
						class="rounded-full bg-zinc-950 px-4.5 py-2.5 font-mono text-xs tracking-widest text-white hover:bg-zinc-800"
						{{ theme.contact.link.target == '_blank' ? 'target="_blank" rel="noopener noreferrer"' }}
					>
						{{- theme.contact.link.title -}}
					</a>
				{%- endif -%}

				{%- if nav_menus.main -%}
					<cinq-drawer-button class="lg:hidden">
						<button
							type="button"
							class="group/drawer-button flex size-10 items-center justify-center rounded-full border border-zinc-200"
							aria-controls="menu-drawer"
							aria-label="{{ __('Menu', 'wp-cinquante-et-un') }}"
						>
							<span class="flex flex-col gap-1.25 group-aria-expanded/drawer-button:hidden">
								<span class="h-0.5 w-4.5 bg-zinc-950"></span>
								<span class="h-0.5 w-4.5 bg-zinc-950"></span>
							</span>
							{{-
								include(
									'svg/use.html.twig',
									{
										classes: ['size-5 hidden group-aria-expanded/drawer-button:block'],
										icon: 'times'
									}
								)
							-}}
						</button>
					</cinq-drawer-button>
				{%- endif -%}
			</div>
		{%- endif -%}
	</div>
</header>

{%- if nav_menus.main -%}
	{% embed 'components/drawer.html.twig'
		with {
			id: 'menu-drawer',
			margin_top: '4rem',
			panel_classes: 'bg-white inset-0',
			aria_label: __('Menu', 'wp-cinquante-et-un')
		}
	%}
		{% block content %}
			<cinq-mobile-menu class="relative block h-full">
				{{-
					include(
						'components/mobile-menu.html.twig',
						{
							items: nav_menus.main.get_items()
						}
					)
				-}}
			</cinq-mobile-menu>
		{% endblock %}
	{% endembed %}
{%- endif -%}
