{#
 # Header
 #
 # Sticky 64px bar: logo, main nav (desktop), contact CTA, mobile drawer.
 #
 # @package WPCinquanteEtUn
 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}

{%- set theme_opts = theme | default({}) -%}
{%- set contact_link = theme_opts.contact.link | default({}) -%}
{%- set main_items = nav_menus.main is defined and nav_menus.main
	? nav_menus.main.get_items() | default([])
	: []
-%}

<header
	role="banner"
	itemscope
	itemtype="https://schema.org/WPHeader"
	class="{{
	html_classes(
		'border-border sticky top-0 z-10 h-16 border-b bg-page/85 backdrop-blur-[0.875rem]',
		classes | default([]) | join(' ')
	)
	}}"
>
	<div class="container flex h-full items-center justify-between gap-4">
		<a href="{{ site.link }}" class="shrink-0" aria-label="{{ site.name }}">
			<img
				class="block h-4.75 w-16"
				src="{{ asset('src/img/svg/logo.svg') }}"
				alt="{{ site.name }}"
				width="64"
				height="19"
			/>
		</a>

		{%- if main_items | length -%}
			<nav aria-label="{{ __('Main navigation', 'wp-cinquante-et-un') }}" class="hidden lg:block">
				<ul class="label flex gap-8">
					{%- for item in main_items -%}
						<li itemscope itemtype="https://schema.org/SiteNavigationElement">
							<a
								href="{{ item.url }}"
								itemprop="url"
								class="{{
								html_classes(
									item.current
										or 'current-menu-parent' in item.classes
										or 'current-page-ancestor' in item.classes
										? ''
										: 'text-muted hover:text-primary',
									item.classes | default([]) | join(' ')
								)
								}}"
								{{ item.children | length ? 'aria-haspopup="true"' }}
								{{
								item.is_target_blank or item.is_external
									? 'target="' ~ item.target ~ '" rel="noopener noreferrer"'
								}}
							>
								<span itemprop="name">{{- item.title -}}</span>
							</a>
						</li>
					{%- endfor -%}
				</ul>
			</nav>
		{%- endif -%}

		{%- if contact_link.url or main_items | length -%}
			<div class="flex items-center gap-4">
				{%- if contact_link.url -%}
					<a
						href="{{ contact_link.url }}"
						class="label bg-accent hover:bg-accent-hover rounded-full px-4.5 py-2.5 text-on-accent"
						{{ contact_link.target == '_blank' ? 'target="_blank" rel="noopener noreferrer"' }}
					>
						{{- contact_link.title -}}
					</a>
				{%- endif -%}

				{%- if main_items | length -%}
					<cinq-drawer-button class="lg:hidden">
						<button
							type="button"
							class="group/drawer-button border-border flex size-10 items-center justify-center rounded-full border"
							aria-controls="menu-drawer"
							aria-label="{{ __('Menu', 'wp-cinquante-et-un') }}"
						>
							<span class="flex flex-col gap-1.25 group-aria-expanded/drawer-button:hidden">
								<span class="bg-primary h-0.5 w-4.5"></span>
								<span class="bg-primary h-0.5 w-4.5"></span>
							</span>
							{{-
								include(
									'svg/use.html.twig',
									{
										classes: ['size-5 hidden group-aria-expanded/drawer-button:block'],
										icon: 'times'
									}
								)
							-}}
						</button>
					</cinq-drawer-button>
				{%- endif -%}
			</div>
		{%- endif -%}
	</div>
</header>

{%- if main_items | length -%}
	{% embed 'components/drawer.html.twig'
		with {
			id: 'menu-drawer',
			margin_top: '4rem',
			panel_classes: 'bg-page inset-0',
			aria_label: __('Menu', 'wp-cinquante-et-un')
		}
	%}
		{% block content %}
			<cinq-mobile-menu class="relative block h-full">
				{{-
					include(
						'components/mobile-menu.html.twig',
						{
							items: main_items
						}
					)
				-}}
			</cinq-mobile-menu>
		{% endblock %}
	{% endembed %}
{%- endif -%}
