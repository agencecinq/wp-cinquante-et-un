{#
 # Header
 #
 # Fixed floating bar: logo, main nav, search, contact CTA, mobile drawer.
 #
 # @package WPCinquanteEtUn
 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}

<header
	role="banner"
	itemscope
	itemtype="https://schema.org/WPHeader"
	class="{{
		html_classes( 'fixed top-0 z-40 w-full pt-4', classes | default( [] ) | join( ' ' ) )
	}}"
>
	<div class="container">
		<div class="flex items-center gap-8 border border-default bg-page px-10 py-4">
			<a href="{{ site.link }}" class="shrink-0" aria-label="{{ site.name }}">
				{%- if theme.header.logo | default( null ) -%}
					{{-
						include(
							'components/image.html.twig',
							{
								image: theme.header.logo,
								classes: [ 'block h-5 w-auto' ],
								loading: 'eager',
							}
						)
					-}}
				{%- else -%}
					<span class="text-sm font-semibold tracking-widest text-primary">{{- site.name -}}</span>
				{%- endif -%}
			</a>

			{%- if nav_menus.main -%}
				<nav
					aria-label="{{ __( 'Main navigation', 'wp-cinquante-et-un' ) }}"
					class="relative hidden min-w-0 flex-1 lg:block"
				>
					<ul class="flex items-center justify-end gap-9">
						{%- for item in nav_menus.main.get_items() -%}
							<li
								itemscope
								itemtype="https://schema.org/SiteNavigationElement"
								class="{{ item.children | length ? 'group relative' : '' }}"
							>
								<a
									href="{{ item.url }}"
									itemprop="url"
									class="{{
										html_classes(
											'inline-flex items-center gap-2 text-xs font-medium text-primary hover:text-secondary',
											item.current
												or 'current-menu-parent' in item.classes
												or 'current-page-ancestor' in item.classes
												? 'text-primary'
												: '',
											item.classes | default( [] ) | join( ' ' )
										)
									}}"
									{{ item.children | length ? 'aria-haspopup="true"' }}
									{{ item.is_target_blank or item.is_external
										? 'target="' ~ item.target ~ '" rel="noopener noreferrer"' }}
								>
									<span itemprop="name">{{- item.title -}}</span>
									{%- if item.children | length -%}
										{{-
											include(
												'svg/use.html.twig',
												{
													icon: 'chevron-down',
													classes: [ 'size-2 shrink-0' ],
												},
												with_context: false
											)
										-}}
									{%- endif -%}
								</a>

								{%- if item.children | length -%}
									{{-
										include(
											'components/nav-menu-items.html.twig',
											{
												items: item.children,
												title: item.title,
												url: item.url,
												id: item.id,
											},
											with_context: false
										)
									-}}
								{%- endif -%}
							</li>
						{%- endfor -%}
					</ul>
				</nav>
			{%- endif -%}

			<div class="flex shrink-0 items-center gap-4">
				{%- if search_url -%}
					<a
						href="{{ search_url }}"
						class="flex size-5 items-center justify-center text-primary hover:text-secondary"
						aria-label="{{ __( 'Search', 'wp-cinquante-et-un' ) }}"
					>
						{{-
							include(
								'svg/use.html.twig',
								{
									icon: 'search',
									classes: [ 'size-5' ],
								},
								with_context: false
							)
						-}}
					</a>
				{%- endif -%}

				{%- if theme.contact.link.url -%}
					<div class="hidden lg:block">
						{{-
							include(
								'components/button.html.twig',
								theme.contact.link | merge( { variant: 'primary' } )
							)
						-}}
					</div>
				{%- endif -%}

				{%- if nav_menus.main -%}
					<button
						type="button"
						class="flex size-10 items-center justify-center border border-default text-primary lg:hidden"
						commandfor="menu-drawer"
						command="toggle-popover"
						aria-label="{{ __( 'Menu', 'wp-cinquante-et-un' ) }}"
					>
						{#- The browser exposes the expanded state of a popover invoker without an attribute: the icons read the popover itself. -#}
						<span class="[html:has(#menu-drawer:popover-open)_&]:hidden">
							{{-
								include(
									'svg/use.html.twig',
									{
										icon: 'bars',
										classes: [ 'size-5' ],
									},
									with_context: false
								)
							-}}
						</span>
						<span class="hidden [html:has(#menu-drawer:popover-open)_&]:block">
							{{-
								include(
									'svg/use.html.twig',
									{
										icon: 'times',
										classes: [ 'size-5' ],
									},
									with_context: false
								)
							-}}
						</span>
					</button>
				{%- endif -%}
			</div>
		</div>
	</div>
</header>

{%- if nav_menus.main -%}
	{% embed 'components/drawer.html.twig'
		with {
			id: 'menu-drawer',
			margin_top: '5.5rem',
			modal: false,
			panel_classes: 'mx-5 border border-default',
			aria_label: __( 'Menu', 'wp-cinquante-et-un' ),
		}
	%}
		{% block content %}
			<cinq-mobile-menu class="relative block h-full">
				{{- include( 'components/mobile-menu.html.twig', { items: nav_menus.main.get_items() } ) -}}
			</cinq-mobile-menu>
		{% endblock %}
	{% endembed %}
{%- endif -%}
