{#
 # Footer
 #
 # Brand column, footer menu groups, legal baseline.
 #
 # @package WPCinquanteEtUn
 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}

<footer
	role="contentinfo"
	itemscope
	itemtype="https://schema.org/WPFooter"
	class="border-zinc-200 border-t bg-zinc-50 pt-18 pb-8 lg:pt-26"
>
	<div class="container">
		<div
			class="border-zinc-200 flex flex-col gap-10 border-b pb-12 lg:flex-row lg:items-start lg:gap-8 lg:pb-20"
		>
			<div class="flex w-full flex-col gap-4 lg:w-90 lg:shrink-0">
				<a href="{{ site.link }}" class="w-fit" aria-label="{{ site.name }}">
					<img
						class="block h-5.25 w-18"
						src="{{ asset('src/img/svg/logo.svg') }}"
						alt="{{ site.name }}"
						width="72"
						height="21"
						loading="lazy"
					/>
				</a>

				{%- if theme.footer.tagline -%}
					<p class="text-zinc-500 max-w-60 text-sm">
						{{- theme.footer.tagline -}}
					</p>
				{%- endif -%}

				{%- if theme.footer.locations or theme.contact.email or theme.contact.phone -%}
					<div class="font-mono text-xs tracking-widest flex flex-col gap-1">
						{%- if theme.footer.locations -%}
							<p class="text-zinc-500">
								{{- theme.footer.locations -}}
							</p>
						{%- endif -%}
						{%- if theme.contact.email -%}
							<a href="mailto:{{ theme.contact.email | e('html_attr') }}" class="text-zinc-950 hover:underline">
								{{- theme.contact.email -}}
							</a>
						{%- endif -%}
						{%- if theme.contact.phone -%}
							<a
								href="tel:{{ theme.contact.phone
									| replace({
										' ': '',
										'.': '',
										'-': ''
									})
									| e('html_attr') }}"
								class="text-zinc-950 hover:underline"
							>
								{{- theme.contact.phone -}}
							</a>
						{%- endif -%}
					</div>
				{%- endif -%}
			</div>

			{%- if nav_menus.footer -%}
				<nav
					aria-label="{{ __('Footer navigation', 'wp-cinquante-et-un') }}"
					class="grid grid-cols-2 gap-x-4 gap-y-10 lg:flex lg:min-w-0 lg:flex-1 lg:gap-8"
				>
					{%- for item in nav_menus.footer.get_items() -%}
						<div class="flex flex-col gap-3 lg:min-w-0 lg:flex-1">
							{%- if item.children | length -%}
								<p class="font-mono text-xs uppercase tracking-widest text-zinc-400">
									{{- item.title -}}
								</p>
								<ul class="flex flex-col gap-3">
									{%- for child in item.children -%}
										<li itemscope itemtype="https://schema.org/SiteNavigationElement">
											<a
												href="{{ child.url }}"
												itemprop="url"
												class="text-zinc-500 hover:text-zinc-950 text-sm"
												{{
												child.is_target_blank or child.is_external
													? 'target="' ~ child.target ~ '" rel="noopener noreferrer"'
												}}
											>
												<span itemprop="name">{{- child.title -}}</span>
											</a>
										</li>
									{%- endfor -%}
								</ul>
							{%- else -%}
								<a
									href="{{ item.url }}"
									itemprop="url"
									class="text-zinc-500 hover:text-zinc-950 text-sm"
									{{
									item.is_target_blank or item.is_external
										? 'target="' ~ item.target ~ '" rel="noopener noreferrer"'
									}}
								>
									{{- item.title -}}
								</a>
							{%- endif -%}
						</div>
					{%- endfor -%}
				</nav>
			{%- endif -%}
		</div>

		<div class="flex flex-col gap-y-3 pt-6 lg:flex-row lg:items-center lg:justify-between">
			<p class="font-mono text-xs tracking-widest text-zinc-400 flex items-center gap-2">
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'mark',
							classes: ['w-2.5 h-1.4 shrink-0']
						}
					)
				-}}
				<span>
					{{- __('© %s %s', 'wp-cinquante-et-un') | format('now' | date('Y'), site.name) -}}
				</span>
			</p>

			{%- if nav_menus.legals -%}
				<ul class="font-mono text-xs tracking-widest text-zinc-400 flex flex-wrap gap-5">
					{%- for item in nav_menus.legals.get_items() -%}
						<li itemscope itemtype="https://schema.org/SiteNavigationElement">
							<a
								href="{{ item.url }}"
								itemprop="url"
								class="hover:text-zinc-950"
								{{
								item.is_target_blank or item.is_external
									? 'target="' ~ item.target ~ '" rel="noopener noreferrer"'
								}}
							>
								<span itemprop="name">{{- item.title -}}</span>
							</a>
						</li>
					{%- endfor -%}
				</ul>
			{%- endif -%}
		</div>
	</div>
</footer>
