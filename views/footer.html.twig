{#
 # Footer
 #
 # Brand column, footer menu groups, legal baseline.
 #
 # @package WPCinquanteEtUn
 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}

{%- set theme_opts = theme | default({}) -%}
{%- set footer_fields = theme_opts.footer | default({}) -%}
{%- set contact_fields = theme_opts.contact | default({}) -%}
{%- set tagline = footer_fields.tagline | default('') -%}
{%- set locations = footer_fields.locations | default('') -%}
{%- set email = contact_fields.email | default('') -%}
{%- set phone = contact_fields.phone | default('') -%}
{%- set footer_items = nav_menus.footer is defined and nav_menus.footer
	? nav_menus.footer.get_items() | default([])
	: []
-%}
{%- set legal_items = nav_menus.legals is defined and nav_menus.legals
	? nav_menus.legals.get_items() | default([])
	: []
-%}

<footer
	role="contentinfo"
	itemscope
	itemtype="https://schema.org/WPFooter"
	class="border-border border-t bg-elevated pt-18 pb-8 lg:pt-26"
>
	<div class="container">
		<div
			class="border-border flex flex-col gap-10 border-b pb-12 lg:flex-row lg:items-start lg:gap-8 lg:pb-20"
		>
			<div class="flex w-full flex-col gap-4 lg:w-90 lg:shrink-0">
				<a href="{{ site.link }}" class="w-fit" aria-label="{{ site.name }}">
					<img
						class="block h-5.25 w-18"
						src="{{ asset('src/img/svg/logo.svg') }}"
						alt="{{ site.name }}"
						width="72"
						height="21"
						loading="lazy"
					/>
				</a>

				{%- if tagline -%}
					<p class="text-muted max-w-60 text-sm">
						{{- tagline -}}
					</p>
				{%- endif -%}

				{%- if locations or email or phone -%}
					<div class="label flex flex-col gap-1">
						{%- if locations -%}
							<p class="text-muted">
								{{- locations -}}
							</p>
						{%- endif -%}
						{%- if email -%}
							<a href="mailto:{{ email | e('html_attr') }}" class="text-accent hover:underline">
								{{- email -}}
							</a>
						{%- endif -%}
						{%- if phone -%}
							<a
								href="tel:{{ phone
									| replace({
										' ': '',
										'.': '',
										'-': ''
									})
									| e('html_attr') }}"
								class="text-accent hover:underline"
							>
								{{- phone -}}
							</a>
						{%- endif -%}
					</div>
				{%- endif -%}
			</div>

			{%- if footer_items | length -%}
				<nav
					aria-label="{{ __('Footer navigation', 'wp-cinquante-et-un') }}"
					class="grid grid-cols-2 gap-x-4 gap-y-10 lg:flex lg:min-w-0 lg:flex-1 lg:gap-8"
				>
					{%- for item in footer_items -%}
						<div class="flex flex-col gap-3 lg:min-w-0 lg:flex-1">
							{%- if item.children | length -%}
								<p class="eyebrow text-subtle">
									{{- item.title -}}
								</p>
								<ul class="flex flex-col gap-3">
									{%- for child in item.children -%}
										<li itemscope itemtype="https://schema.org/SiteNavigationElement">
											<a
												href="{{ child.url }}"
												itemprop="url"
												class="text-muted hover:text-primary text-sm"
												{{
												child.is_target_blank or child.is_external
													? 'target="' ~ child.target ~ '" rel="noopener noreferrer"'
												}}
											>
												<span itemprop="name">{{- child.title -}}</span>
											</a>
										</li>
									{%- endfor -%}
								</ul>
							{%- else -%}
								<a
									href="{{ item.url }}"
									itemprop="url"
									class="text-muted hover:text-primary text-sm"
									{{
									item.is_target_blank or item.is_external
										? 'target="' ~ item.target ~ '" rel="noopener noreferrer"'
									}}
								>
									{{- item.title -}}
								</a>
							{%- endif -%}
						</div>
					{%- endfor -%}
				</nav>
			{%- endif -%}
		</div>

		<div class="flex flex-col gap-y-3 pt-6 lg:flex-row lg:items-center lg:justify-between">
			<p class="label text-subtle flex items-center gap-2">
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'mark',
							classes: ['w-2.5 h-1.4 shrink-0']
						}
					)
				-}}
				<span>
					{{- __('© %s %s', 'wp-cinquante-et-un') | format('now' | date('Y'), site.name) -}}
				</span>
			</p>

			{%- if legal_items | length -%}
				<ul class="label text-subtle flex flex-wrap gap-5">
					{%- for item in legal_items -%}
						<li itemscope itemtype="https://schema.org/SiteNavigationElement">
							<a
								href="{{ item.url }}"
								itemprop="url"
								class="hover:text-primary"
								{{
								item.is_target_blank or item.is_external
									? 'target="' ~ item.target ~ '" rel="noopener noreferrer"'
								}}
							>
								<span itemprop="name">{{- item.title -}}</span>
							</a>
						</li>
					{%- endfor -%}
				</ul>
			{%- endif -%}
		</div>
	</div>
</footer>
