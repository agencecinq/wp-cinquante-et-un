{#
 # Blocks: Cards Grid
 #}

{%- set layout = block.layout | default( {} ) -%}
{%- set cards = block.cards | default( [] ) -%}
{%- set columns = ( block.columns | default( 3 ) ) ~ '' -%}
{%- set col_class =
	{
		'2': 'md:grid-cols-2',
		'3': 'md:grid-cols-3',
		'4': 'md:grid-cols-4',
	}[ columns ] | default( 'md:grid-cols-3' )
-%}

{%- if cards | length -%}
	<section
		{{ html_attr( { id: block.id } ) }}
		class="{{
			html_classes( layout.spacing_top | default( '' ), layout.spacing_bottom | default( '' ) )
		}}"
		data-scheme="{{ layout.color_scheme | default( '' ) }}"
	>
		<div class="{{ html_classes( 'container', 'space-y-10' ) }}">
			{{-
				include(
					'components/section-header.html.twig',
					{
						overline: block.overline,
						title: block.title,
					}
				)
			-}}

			<div class="grid grid-cols-1 gap-8 {{ col_class }}">
				{%- for card in cards -%}
					<article class="flex flex-col gap-4 border border-default bg-page p-6">
						{%- if card.icon -%}
							<div class="size-8 overflow-hidden bg-surface">
								{{-
									include(
										'components/image.html.twig',
										{
											image: card.icon,
											alt: '',
											classes: [ 'size-full object-contain' ],
										}
									)
								-}}
							</div>
						{%- endif -%}

						{%- if card.title -%}
							<h3 class="text-xl font-semibold">{{- card.title -}}</h3>
						{%- endif -%}

						{%- if card.text -%}
							<p class="text-sm text-secondary">{{- card.text | raw -}}</p>
						{%- endif -%}

						{{-
							include(
								'components/text-link.html.twig',
								card.link | default( {} ),
								with_context: false
							)
						-}}
					</article>
				{%- endfor -%}
			</div>
		</div>
	</section>
{%- endif -%}
