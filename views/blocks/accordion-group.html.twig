{#
 # Blocks: Accordion Group (FAQ)
 #
 # Heading on 4 cols (sticky), panels on 7. Native details/summary.
 #}

{%- set layout = block.layout | default( {} ) -%}
{%- set items = block.items | default( [] ) -%}

{%- if items | length -%}
	<section
		{{ html_attr( { id: block.id } ) }}
		class="{{
			html_classes( layout.spacing_top | default( '' ), layout.spacing_bottom | default( '' ) )
		}}"
		data-scheme="{{ layout.color_scheme | default( '' ) }}"
	>
		<div
			class="{{ html_classes( 'container', 'grid grid-cols-12 items-start gap-x-8 gap-y-10' ) }}"
		>
			<div class="col-span-full space-y-3 lg:sticky lg:top-24 lg:col-span-4">
				{{- include( 'components/subtitle.html.twig', { title: block.overline } ) -}}

				{%- if block.title -%}
					<h2 class="text-2xl font-semibold">{{- block.title -}}</h2>
				{%- endif -%}
			</div>

			<div class="col-span-full lg:col-span-7 lg:col-start-6">
				{{- include( 'components/accordion-group.html.twig', { items: items } ) -}}
			</div>
		</div>

		{%- if block.faq_schema_json | default( '' ) -%}
			<script type="application/ld+json">
				{{- block.faq_schema_json | raw -}}
			</script>
		{%- endif -%}
	</section>
{%- endif -%}
