{%- set layout = block.layout | default({}) -%}
{%- set content = block.content | default({}) -%}
{%- set view_all = content.link | default({}) -%}
{%- if not view_all.url and posts_url -%}
	{%- set view_all = {
		title: __('View all posts', 'wp-cinquante-et-un'),
		url: posts_url
	} -%}
{%- endif -%}

{{-
	include(
		'components/collection-posts.html.twig',
		{
			attributes: {
				'data-color-scheme': layout.color_scheme | default('default')
			} | merge(block.id ? { id: block.id } : {}),
			classes: [ layout.classes | default('') ],
			container_classes: layout.container_classes | default('container'),
			content: content | merge({ link: view_all }),
			posts: block.posts | default(
				get_posts({
					post_type: 'post',
					cat: content.category,
					posts_per_page: content.posts_per_page | default(4)
				})
			)
		}
	)
-}}
