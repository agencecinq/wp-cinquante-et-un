{#
 # Blocks: Hero
 #
 # Full-bleed media, overline, title, text, primary + secondary buttons.
 #}

{%- set layout = block.layout | default({}) -%}
{%- set content = block.content | default({}) -%}

<section
	{% if block.id %}id="{{ block.id }}"{% endif %}
	class="{{ html_classes( layout.classes | default(''), 'relative h-160 overflow-hidden' ) }}"
	data-color-scheme="{{ layout.color_scheme | default('default') }}"
>
	<div class="absolute inset-0 z-10 bg-gray-100 border border-black">
		{{-
			include(
				'components/media.html.twig',
				{
					media: block.media,
					classes: ['absolute inset-0 z-10 size-full object-cover object-center']
				}
			)
		-}}
		{%- if block.show_media_overlay -%}
			<div class="absolute inset-0 z-20 bg-linear-to-b from-transparent to-black/20"></div>
		{%- endif -%}
	</div>

	<div class="{{ html_classes( 'relative z-30', layout.container_classes | default('container'), 'grid h-full grid-cols-12 items-center gap-5' ) }}">
		<div class="col-span-full space-y-6 lg:col-span-6">
			{{- include('components/subtitle.html.twig', { title: content.overline }) -}}

			{%- if content.title -%}
				<{{ content.heading | default('h1') }} class="text-5xl font-semibold">
					{{- content.title | raw -}}
				</{{ content.heading | default('h1') }}>
			{%- endif -%}

			{%- if content.text -%}
				<p class="text-lg">
					{{- content.text | raw -}}
				</p>
			{%- endif -%}

			{%- if content.link.url or content.secondary_link.url -%}
				<div class="flex flex-wrap gap-3">
					{{-
						include(
							'components/button.html.twig',
							content.link | default({}) | merge({ variant: 'primary' }),
							with_context = false
						)
					-}}
					{{-
						include(
							'components/button.html.twig',
							content.secondary_link | default({}) | merge({ variant: 'secondary' }),
							with_context = false
						)
					-}}
				</div>
			{%- endif -%}
		</div>
	</div>
</section>
