{#
 # Blocks: Columns
 # Two-column text layout.
 #}

{%- set layout = block.layout | default({}) -%}

<section
	{% if block.id %}id="{{ block.id }}"{% endif %}
	class="{{ html_classes( layout.classes | default(''), 'block-columns' ) }}"
	data-color-scheme="{{ layout.color_scheme | default('default') }}"
>
	<div class="{{ html_classes( layout.container_classes | default('container'), 'grid grid-cols-12 gap-x-2.5 gap-y-7.5 lg:gap-x-5' ) }}">
		{%- if block.content.column_left -%}
			<div class="col-span-full lg:col-span-6">
				<div class="text-xl">
					{{- block.content.column_left|raw -}}
				</div>
			</div>
		{%- endif -%}
		{%- if block.content.column_right -%}
			<div class="col-span-full lg:col-span-6 lg:mx-12.5">
				<div class="text-xl">
					{{- block.content.column_right|raw -}}
				</div>
			</div>
		{%- endif -%}
	</div>
</section>
