{#
 # Blocks: Columns
 # Two-column text layout.
 #}

{%- set layout = block.layout | default( {} ) -%}

<section
	{{ html_attr( { id: block.id } ) }}
	class="{{
		html_classes(
			layout.spacing_top | default( '' ),
			layout.spacing_bottom | default( '' ),
			'block-columns'
		)
	}}"
	data-scheme="{{ layout.color_scheme | default( '' ) }}"
>
	<div
		class="{{ html_classes( 'container', 'grid grid-cols-12 gap-x-2.5 gap-y-7.5 lg:gap-x-5' ) }}"
	>
		{%- if block.content.column_left -%}
			<div class="col-span-full lg:col-span-6">
				<div class="text-xl">
					{{- block.content.column_left | raw -}}
				</div>
			</div>
		{%- endif -%}
		{%- if block.content.column_right -%}
			<div class="col-span-full lg:col-span-6 lg:mx-12.5">
				<div class="text-xl">
					{{- block.content.column_right | raw -}}
				</div>
			</div>
		{%- endif -%}
	</div>
</section>
