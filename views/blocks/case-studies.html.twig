{#
 # Blocks: Case Studies
 #}

{%- set layout = block.layout | default({}) -%}
{%- set content = block.content | default({}) -%}
{%- set items = block.items | default([]) -%}

{%- if items | length -%}
	<section
		{% if block.id %}id="{{ block.id }}"{% endif %}
class="{{ html_classes( layout.classes | default('') ) }}"
	data-color-scheme="{{ layout.color_scheme | default('default') }}"
	>
		<div class="{{ html_classes( layout.container_classes | default('container'), 'space-y-10' ) }}">
			{{-
				include(
					'components/section-header.html.twig',
					{
						overline: content.overline,
						title: content.title,
						link: content.link
					}
				)
			-}}

			<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
				{%- for item in items -%}
					<article class="flex flex-col gap-4">
						<div class="relative aspect-4/3 overflow-hidden border border-black bg-gray-100">
							{%- if item.url -%}
								<a
									href="{{ item.url }}"
									class="absolute inset-0 z-2"
									aria-label="{{ item.title }}"
									tabindex="-1"
								></a>
							{%- endif -%}
							{{-
								include(
									'components/image.html.twig',
									{
										image: item.image,
										classes: ['relative z-1 size-full object-cover object-center']
									}
								)
							-}}
						</div>

						<div class="space-y-3">
							<div class="flex items-center gap-3">
								{{- include('components/tag.html.twig', { title: item.sector }) -}}
								{%- if item.client -%}
									<p class="text-xs font-medium">{{- item.client -}}</p>
								{%- endif -%}
							</div>

							{%- if item.title -%}
								<h3 class="text-xl font-semibold">
									{%- if item.url -%}
										<a href="{{ item.url }}">{{- item.title -}}</a>
									{%- else -%}
										{{- item.title -}}
									{%- endif -%}
								</h3>
							{%- endif -%}

							{%- if item.result_value or item.result_label -%}
								<p class="flex items-baseline gap-2">
									{%- if item.result_value -%}
										<span class="text-2xl font-semibold">{{- item.result_value -}}</span>
									{%- endif -%}
									{%- if item.result_label -%}
										<span class="text-sm text-gray-600">{{- item.result_label -}}</span>
									{%- endif -%}
								</p>
							{%- endif -%}
						</div>
					</article>
				{%- endfor -%}
			</div>
		</div>
	</section>
{%- endif -%}
