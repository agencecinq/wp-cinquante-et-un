{#
 # Blocks: Case Studies
 #}

{%- set layout = block.layout | default({}) -%}
{%- set overline = block.overline | default(block.content.overline | default('')) -%}
{%- set title = block.title | default(block.content.title | default('')) -%}
{%- set link = block.link | default(block.content.link | default({})) -%}
{%- set items = block.items | default([]) -%}
{%- set columns = block.columns | default(3) -%}
{%- set hide_if_empty = block.hide_if_empty is defined ? block.hide_if_empty : true -%}
{%- set grid_classes =
	columns == 2
		? 'grid-cols-1 gap-8 md:grid-cols-2'
		: 'grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3'
-%}

{%- if items | length or not hide_if_empty -%}
	<section
		{% if block.id %}id="{{ block.id }}"{% endif %}
		class="{{ html_classes( layout.classes | default('') ) }}"
		data-color-scheme="{{ layout.color_scheme | default('default') }}"
	>
		<div class="{{ html_classes( layout.container_classes | default('container'), 'space-y-10' ) }}">
			{{-
				include(
					'components/section-header.html.twig',
					{
						overline: overline,
						title: title,
						link: link
					}
				)
			-}}

			{%- if items | length -%}
				<div class="grid {{ grid_classes }}">
					{%- for item in items -%}
						{{- include('components/tease-case-study.html.twig', { item: item }, with_context = false) -}}
					{%- endfor -%}
				</div>
			{%- endif -%}
		</div>
	</section>
{%- endif -%}
