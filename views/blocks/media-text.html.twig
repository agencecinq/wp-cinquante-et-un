{#
 # Blocks: Media Text
 #
 # Media on 6 cols, gutter, text on 5. Stacks media-first on small screens.
 #}

{%- set layout = block.layout | default({}) -%}
{%- set content = block.content | default({}) -%}
{%- set media_first = block.media_position | default('left') != 'right' -%}

<section
	{% if block.id %}id="{{ block.id }}"{% endif %}
	class="{{ html_classes( layout.classes | default('') ) }}"
	data-color-scheme="{{ layout.color_scheme | default('default') }}"
>
	<div
		class="{{
		html_classes(
			layout.container_classes | default('container'),
			'grid grid-cols-12 items-center gap-x-8 gap-y-8',
			not media_first ? 'lg:[&>*:first-child]:col-start-8 lg:[&>*:last-child]:col-start-1 lg:[&>*:last-child]:row-start-1'
		)
		}}"
	>
		<div class="col-span-full overflow-hidden border border-black bg-gray-100 aspect-4/3 lg:col-span-6">
			{{-
				include(
					'components/media.html.twig',
					{
						media: block.media,
						classes: ['block size-full object-cover object-center']
					}
				)
			-}}
		</div>

		<div class="col-span-full space-y-5 lg:col-span-5 lg:col-start-8">
			{{- include('components/subtitle.html.twig', { title: content.overline }) -}}

			{%- if content.title -%}
				<{{ content.heading | default('h2') }} class="text-2xl font-semibold">
					{{- content.title | raw -}}
				</{{ content.heading | default('h2') }}>
			{%- endif -%}

			{%- if content.text -%}
				<div class="wysiwyg text-gray-600">
					{{- content.text | raw -}}
				</div>
			{%- endif -%}

			{{-
				include(
					'components/button.html.twig',
					content.link | default({}) | merge({ variant: 'secondary' }),
					with_context = false
				)
			-}}
		</div>
	</div>
</section>
