{#
 # Blocks: Form
 #
 # Pitch + plugin form. Split (5 + 6 cols) or centered (720 px).
 #}

{%- set layout = block.layout | default( {} ) -%}
{%- set form_id = block.form_id | default( block.form | default( null ) ) -%}
{%- set form_layout = block.form_layout | default( 'split' ) -%}

{%- if block.overline or block.title or block.text or form_id -%}
	<section
		{{ html_attr( { id: block.id } ) }}
		class="{{
			html_classes( layout.spacing_top | default( '' ), layout.spacing_bottom | default( '' ) )
		}}"
		data-scheme="{{ layout.color_scheme | default( '' ) }}"
	>
		<div class="{{ html_classes( 'container' ) }}">
			{%- if form_layout == 'centered' -%}
				<div class="mx-auto max-w-prose space-y-6 text-center">
					<div class="space-y-5">
						{{- include( 'components/subtitle.html.twig', { title: block.overline } ) -}}

						{%- if block.title -%}
							<h2 class="text-2xl font-semibold">{{- block.title -}}</h2>
						{%- endif -%}

						{%- if block.text -%}
							<div class="wysiwyg prose-base text-secondary">
								{{- block.text | raw -}}
							</div>
						{%- endif -%}
					</div>

					{%- if form_id -%}
						<div class="text-left">
							{{- function( 'do_shortcode', '[contact-form-7 id="' ~ form_id ~ '"]' ) -}}
						</div>
					{%- endif -%}
				</div>
			{%- else -%}
				<div class="grid grid-cols-12 items-start gap-x-8 gap-y-10">
					<div class="col-span-full space-y-5 lg:col-span-5">
						{{- include( 'components/subtitle.html.twig', { title: block.overline } ) -}}

						{%- if block.title -%}
							<h2 class="text-2xl font-semibold">{{- block.title -}}</h2>
						{%- endif -%}

						{%- if block.text -%}
							<div class="wysiwyg prose-base text-secondary">
								{{- block.text | raw -}}
							</div>
						{%- endif -%}
					</div>

					{%- if form_id -%}
						<div class="col-span-full lg:col-span-6 lg:col-start-7">
							{{- function( 'do_shortcode', '[contact-form-7 id="' ~ form_id ~ '"]' ) -}}
						</div>
					{%- endif -%}
				</div>
			{%- endif -%}
		</div>
	</section>
{%- endif -%}
