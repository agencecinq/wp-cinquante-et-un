{#
 # Blocks: Form
 #
 # Pitch on 5 cols, plugin form on 6. The block references an external form, it does not define fields.
 #}

{%- set layout = block.layout | default({}) -%}
{%- set content = block.content | default({}) -%}
{%- set form_id = block.form | default(null) -%}

{%- if content.overline or content.title or content.text or form_id -%}
	<section
		{% if block.id %}id="{{ block.id }}"{% endif %}
class="{{ html_classes( layout.classes | default('') ) }}"
	data-color-scheme="{{ layout.color_scheme | default('default') }}"
	>
		<div class="{{ html_classes( layout.container_classes | default('container'), 'grid grid-cols-12 items-start gap-x-8 gap-y-10' ) }}">
			<div class="col-span-full space-y-5 lg:col-span-5">
				{{- include('components/subtitle.html.twig', { title: content.overline }) -}}

				{%- if content.title -%}
					<h2 class="text-2xl font-semibold">
						{{- content.title -}}
					</h2>
				{%- endif -%}

				{%- if content.text -%}
					<p class="prose-base text-gray-600">
						{{- content.text | raw -}}
					</p>
				{%- endif -%}
			</div>

			{%- if form_id -%}
				<div class="col-span-full lg:col-span-6 lg:col-start-7">
					{{-
						function(
							'do_shortcode',
							'[contact-form-7 id="' ~ form_id ~ '"]'
						)
					-}}
				</div>
			{%- endif -%}
		</div>
	</section>
{%- endif -%}
