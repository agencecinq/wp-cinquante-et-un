{#
 # Blocks: Contact
 #
 # Coordinates and static map. 5 cols info + 6 cols map.
 #}

{%- set layout = block.layout | default( {} ) -%}
{%- set hours = block.hours | default( [] ) -%}
{%- set has_hours = false -%}

{%- for row in hours -%}
	{%- if row.days or row.hours -%}
		{%- set has_hours = true -%}
	{%- endif -%}
{%- endfor -%}

{%- set has_details = block.address or block.phone or block.email or has_hours -%}
{%- set has_map = block.map_image -%}

{%- if block.title or has_details or has_map -%}
	<section
		{{ html_attr( { id: block.id } ) }}
		class="{{
			html_classes( layout.spacing_top | default( '' ), layout.spacing_bottom | default( '' ) )
		}}"
		data-scheme="{{ layout.color_scheme | default( '' ) }}"
	>
		<div
			class="{{ html_classes( 'container', 'grid grid-cols-12 items-start gap-x-8 gap-y-10' ) }}"
		>
			<div class="col-span-full space-y-6 lg:col-span-5">
				{%- if block.title -%}
					<h2 class="text-2xl font-semibold">{{- block.title -}}</h2>
				{%- endif -%}

				{{-
					include(
						'components/contact-details.html.twig',
						{
							address: block.address,
							phone: block.phone,
							email: block.email,
							hours: hours,
						}
					)
				-}}
			</div>

			{%- if has_map -%}
				<div class="col-span-full lg:col-span-6 lg:col-start-7">
					<{{ block.map_link ? 'a' : 'div' }}
						{{
							html_attr(
								block.map_link
									? {
										href: block.map_link,
										target: '_blank',
										rel: 'noopener noreferrer',
									}
							)
						}}
						class="{{ html_classes( 'border border-default', { block: block.map_link } ) }}"
					>
						{{-
							include(
								'components/image.html.twig',
								{
									image: block.map_image,
									classes: [ 'block', 'aspect-3/2', 'size-full', 'object-cover' ],
									alt: block.title | default( '' ),
								}
							)
						-}}
					</{{ block.map_link ? 'a' : 'div' }}>
				</div>
			{%- endif -%}
		</div>

		{%- if block.local_business_schema_json | default( '' ) -%}
			<script type="application/ld+json">
				{{- block.local_business_schema_json | raw -}}
			</script>
		{%- endif -%}
	</section>
{%- endif -%}
