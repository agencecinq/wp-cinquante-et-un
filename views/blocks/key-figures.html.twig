{#
 # Blocks: Key Figures
 #}

{%- set layout = block.layout | default( {} ) -%}
{%- set figures = block.figures | default( [] ) -%}

{%- if figures | length -%}
	<section
		{{ html_attr( { id: block.id } ) }}
		class="{{
			html_classes( layout.spacing_top | default( '' ), layout.spacing_bottom | default( '' ) )
		}}"
		data-scheme="{{ layout.color_scheme | default( '' ) }}"
	>
		<div class="{{ html_classes( 'container', 'space-y-10' ) }}">
			{{-
				include(
					'components/section-header.html.twig',
					{
						overline: block.overline,
						title: block.title,
					}
				)
			-}}

			<div class="flex flex-col gap-8 lg:flex-row">
				{%- for figure in figures -%}
					<div class="min-w-0 flex-1 space-y-2 border-l border-default pl-6">
						<p class="flex items-baseline gap-1 font-semibold">
							<span class="text-4xl">{{- figure.value -}}</span>
							{%- if figure.suffix -%}
								<span class="text-2xl text-secondary">{{- figure.suffix -}}</span>
							{%- endif -%}
						</p>
						{%- if figure.label -%}
							<p class="text-sm text-secondary">{{- figure.label -}}</p>
						{%- endif -%}
					</div>
				{%- endfor -%}
			</div>
		</div>
	</section>
{%- endif -%}
