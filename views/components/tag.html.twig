{#
 # Tag: outlined label (category, status). One visual style; content varies.
 #
 # @param string title The tag label.
 # @param string url Optional. Renders an <a> when set.
 # @param string target '_self' or '_blank'. Links only.
 # @param attributes Extra HTML attributes.
 # @param array classes Extra CSS classes.
 #}

{%- if title -%}
	{%- set classes =
		[
			'inline-flex items-center whitespace-nowrap',
			'border border-black px-2 py-1',
			'text-xs leading-none text-black no-underline'
		]
			| merge(classes | default([]))
			| join(' ')
	-%}

	{%- if url -%}
		<a
			href="{{ url }}"
			class="{{ html_classes(classes) }}"
			{{ target ? 'target="' ~ target ~ '"' : '' }}
			{{ target == '_blank' ? 'rel="noopener noreferrer"' : '' }}
			{{
			attributes
				? attributes
					| map((value, key) => value == '' ? key : key ~ '="' ~ value ~ '"')
					| join(' ')
					| raw
			}}
		>
			{{- title -}}
		</a>
	{%- else -%}
		<span
			class="{{ html_classes(classes) }}"
			{{
			attributes
				? attributes
					| map((value, key) => value == '' ? key : key ~ '="' ~ value ~ '"')
					| join(' ')
					| raw
			}}
		>
			{{- title -}}
		</span>
	{%- endif -%}
{%- endif -%}
