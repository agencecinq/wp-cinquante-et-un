{#
 # Components: Modal
 #
 # Native dialog in `cinq-modal` (@agencecinq/modal 6). Open it with a
 # `commandfor="{id}" command="show-modal"` button. A backdrop click,
 # Escape or the close button closes it.
 #
 # @param string id Dialog ID. Required.
 # @param string [title] Heading, also the dialog accessible name.
 # @param string [label] Accessible name when there is no title.
 # @param array [classes] Extra classes on the `cinq-modal` host.
 #
 # @example
 # {% embed 'components/modal.html.twig' with { id: 'help', title: 'Help' } %}
 # 	{% block content %}<p>…</p>{% endblock %}
 # {% endembed %}
 #}

<cinq-modal class="{{ html_classes( 'block', classes | default( [] ) | join( ' ' ) ) }}">
	<dialog
		id="{{ id }}"
		closedby="any"
		class="m-auto scrollbar-hidden w-full max-w-[calc(100vw-(--spacing(5)))] bg-transparent text-primary backdrop:bg-overlay-scrim/50 lg:w-114.75"
		{{
			html_attr(
				title ? { 'aria-labelledby': id ~ '-title' } : { 'aria-label': label | default( null ) }
			)
		}}
	>
		<div class="space-y-5 bg-page p-7.5">
			<div class="flex items-start justify-between gap-4">
				{%- if title -%}
					<h2 class="text-xl font-semibold" id="{{ id }}-title">{{- title -}}</h2>
				{%- endif -%}

				<button
					type="button"
					class="ms-auto flex size-8.75 shrink-0 items-center justify-center bg-inverse text-inverse"
					commandfor="{{ id }}"
					command="request-close"
					aria-label="{{ __( 'Close', 'wp-cinquante-et-un' ) }}"
				>
					{{-
						include(
							'svg/use.html.twig',
							{
								icon: 'times',
								classes: [ 'size-5 pointer-events-none' ],
							},
							with_context: false
						)
					-}}
				</button>
			</div>

			{%- block content -%}{%- endblock -%}
		</div>
	</dialog>
</cinq-modal>
