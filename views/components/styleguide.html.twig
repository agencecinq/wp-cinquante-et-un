					data-autoselect="true"
				>
					<input
						class="min-w-0 flex-1 border border-black px-3 py-2 text-sm font-medium"
						id="styleguide-city"
						type="text"
						role="combobox"
						aria-autocomplete="list"
						aria-expanded="false"
						aria-controls="styleguide-city-listbox"
						autocomplete="off"
					/>
					<button
						class="-ml-px flex size-10 shrink-0 items-center justify-center border border-black bg-white hover:bg-gray-100"
						type="button"
						tabindex="-1"
						aria-label="{{ __('Cities', 'wp-cinquante-et-un') }}"
						aria-controls="styleguide-city-listbox"
						aria-expanded="false"
					>
						{{-
							include(
								'svg/use.html.twig',
								{
									icon: 'chevron-down',
									classes: ['size-4']
								},
								with_context = false
							)
						-}}
					</button>
					<ul
						class="z-2 border border-gray-200 bg-white **:[[role=option]]:cursor-pointer **:[[role=option]]:px-3 **:[[role=option]]:py-2 **:[[role=option][aria-selected=true]]:bg-black **:[[role=option][aria-selected=true]]:text-white"
						id="styleguide-city-listbox"
						role="listbox"
						aria-label="{{ __('Cities', 'wp-cinquante-et-un') }}"
						hidden
					></ul>
				</cinq-combobox>
			</div>
		</div>
	</div>
</section>
</div>
