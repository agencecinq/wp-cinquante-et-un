							aria-selected="false"
							aria-controls="styleguide-tab-two"
							id="styleguide-tab-btn-two"
							tabindex="-1"
						>
							{{- __('Two', 'wp-cinquante-et-un') -}}
						</button>
						<button
							type="button"
							class="{{ tab_classes }}"
							role="tab"
							aria-selected="false"
							aria-controls="styleguide-tab-three"
							id="styleguide-tab-btn-three"
							tabindex="-1"
						>
							{{- __('Three', 'wp-cinquante-et-un') -}}
						</button>
					</div>
					<section
						class="is-active text-sm text-gray-600"
						tabindex="0"
						role="tabpanel"
						aria-labelledby="styleguide-tab-btn-one"
						id="styleguide-tab-one"
					>
						{{- __('First panel. Arrow keys move between tabs.', 'wp-cinquante-et-un') -}}
					</section>
					<section
						class="text-sm text-gray-600"
						tabindex="0"
						role="tabpanel"
						aria-labelledby="styleguide-tab-btn-two"
						id="styleguide-tab-two"
						hidden
					>
						{{- __('Second panel.', 'wp-cinquante-et-un') -}}
					</section>
					<section
						class="text-sm text-gray-600"
						tabindex="0"
						role="tabpanel"
						aria-labelledby="styleguide-tab-btn-three"
						id="styleguide-tab-three"
						hidden
					>
						{{- __('Third panel.', 'wp-cinquante-et-un') -}}
					</section>
				</cinq-tabs>
			</div>
		</div>

		<div class="space-y-6" id="styleguide-ui-accordion">
			<header class="space-y-2">
				<h3 class="text-xl font-semibold">
					{{- __('Accordion', 'wp-cinquante-et-un') -}}
				</h3>
				<p class="text-gray-500 max-w-prose text-sm">
					{{-
						__(
							'JS accordion from CINQ UI. Production FAQ blocks use the native details/summary component instead.',
							'wp-cinquante-et-un'
						)
					-}}
				</p>
				<p class="font-mono text-xs text-gray-500">
					@agencecinq/accordion · components/accordion-group.html.twig
				</p>
			</header>
			<div class="max-w-prose border border-black p-6">
				<cinq-accordion class="block border-t border-gray-200" data-hash="false">
					<div
						class="border-b border-gray-200 py-6 data-[open=true]:flex data-[open=true]:flex-col data-[open=true]:gap-4"
