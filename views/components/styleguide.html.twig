	<section class="space-y-8" aria-labelledby="styleguide-tag">
		<header class="space-y-3">
			<p class="subtitle">{{- __( 'Components', 'wp-cinquante-et-un' ) -}}</p>
			<h2 id="styleguide-tag" class="text-2xl font-semibold">
				{{- __( 'Tag', 'wp-cinquante-et-un' ) -}}
			</h2>
			<p class="max-w-prose text-sm text-secondary">
				{{-
					__(
						'Taxonomy label for article categories, case study sectors, or post tags. One visual style; labels come from get_the_terms(), never from a hand-typed ACF field.',
						'wp-cinquante-et-un'
					)
				-}}
			</p>
		</header>

		<div class="space-y-8">
			<div class="space-y-3">
				<p class="font-mono text-xs tracking-widest">components/tag.html.twig</p>
				<div class="flex flex-wrap items-center gap-2">
					{{-
						include( 'components/tag.html.twig', { title: __( 'Strategy', 'wp-cinquante-et-un' ) } )
					-}}
					{{-
						include( 'components/tag.html.twig', { title: __( 'Method', 'wp-cinquante-et-un' ) } )
					-}}
				</div>
			</div>

			<div class="space-y-3">
				<p class="font-mono text-xs tracking-widest">
					{{- __( 'Linked tag', 'wp-cinquante-et-un' ) -}}
				</p>
				{{-
					include(
						'components/tag.html.twig',
						{
							title: __( 'Strategy', 'wp-cinquante-et-un' ),
							url: '#',
