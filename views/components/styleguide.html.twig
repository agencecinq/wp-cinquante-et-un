				<h3 class="text-xl font-semibold">
					{{- __('Skip links', 'wp-cinquante-et-un') -}}
				</h3>
				<p class="text-gray-500 max-w-prose text-sm">
					{{-
						__(
							'First focusable element in the document. Visible on keyboard focus only.',
							'wp-cinquante-et-un'
						)
					-}}
