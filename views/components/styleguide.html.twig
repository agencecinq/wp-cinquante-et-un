							<div class="text-sm text-gray-600" data-inner>
								{{-
									__(
										'We reopen the estimate, agree on the extra, then we build.',
										'wp-cinquante-et-un'
									)
								-}}
							</div>
						</div>
					</div>
				</cinq-accordion>
			</div>
		</div>

		<div class="space-y-6" id="styleguide-ui-disclosure">
			<header class="space-y-2">
				<h3 class="text-xl font-semibold">
					{{- __('Disclosure', 'wp-cinquante-et-un') -}}
