							<span
								class="relative flex size-8 shrink-0 items-center justify-center bg-gray-100"
								aria-hidden="true"
							>
								<span class="in-data-[open=true]:hidden">
									{{-
										include(
											'svg/use.html.twig',
											{
												classes: ['size-3'],
												icon: 'plus'
											},
											with_context = false
										)
									-}}
								</span>
								<span class="hidden in-data-[open=true]:block">
									{{-
										include(
											'svg/use.html.twig',
											{
												classes: ['size-3'],
												icon: 'minus'
											},
											with_context = false
										)
									-}}
								</span>
							</span>
						</button>
						<div
							id="styleguide-acc-2-body"
							role="region"
							aria-labelledby="styleguide-acc-2-header"
							hidden
