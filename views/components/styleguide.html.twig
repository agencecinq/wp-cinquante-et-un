					<p>
						{{-
							__(
								'Each layout maps to a Twig file the team can version and review.',
								'wp-cinquante-et-un'
							)
						-}}
					</p>
					<h2 id="performance-budgets">{{- __('Performance budgets', 'wp-cinquante-et-un') -}}</h2>
					<p>
						{{-
							__(
								'Core Web Vitals are checked before launch, not after.',
								'wp-cinquante-et-un'
							)
						-}}
					</p>
					<h2 id="editor-experience">{{- __('Editor experience', 'wp-cinquante-et-un') -}}</h2>
					<p>
						{{-
							__(
								'Marketing teams compose pages without touching markup.',
								'wp-cinquante-et-un'
							)
						-}}
					</p>
				</div>
			</div>
		</div>

		<div class="space-y-6" id="styleguide-shell-skip-links">
