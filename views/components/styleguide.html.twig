{#
 # Styleguide catalog: colors, type, radius, buttons, chips, icons, CINQ UI.
 #}

{%- set color_groups = [
	{
		title: __('Backgrounds', 'wp-cinquante-et-un'),
		colors: [
			{ name: 'page', class: 'bg-page', token: '--color-page' },
			{ name: 'elevated', class: 'bg-elevated', token: '--color-elevated' },
			{ name: 'card', class: 'bg-card', token: '--color-card' },
			{ name: 'card-hover', class: 'bg-card-hover', token: '--color-card-hover' }
		]
	},
	{
		title: __('Texts', 'wp-cinquante-et-un'),
		colors: [
			{ name: 'primary', class: 'bg-primary', token: '--color-primary' },
			{ name: 'muted', class: 'bg-muted', token: '--color-muted' },
			{ name: 'subtle', class: 'bg-subtle', token: '--color-subtle' },
			{ name: 'on-accent', class: 'bg-on-accent', token: '--color-on-accent' }
		]
	},
	{
		title: __('Accent & borders', 'wp-cinquante-et-un'),
		colors: [
			{ name: 'accent', class: 'bg-accent', token: '--color-accent' },
			{ name: 'accent-hover', class: 'bg-accent-hover', token: '--color-accent-hover' },
			{ name: 'accent-soft', class: 'bg-accent-soft', token: '--color-accent-soft' },
			{ name: 'border', class: 'bg-border', token: '--color-border' },
			{ name: 'border-subtle', class: 'bg-border-subtle', token: '--color-border-subtle' }
		]
	}
] -%}

{%- set titles = [
	{
		class: 'title-3xl',
		sample: __('A site that grows with you.', 'wp-cinquante-et-un')
	},
	{
		class: 'title-xxl',
		sample: __('Five commitments. None negotiable.', 'wp-cinquante-et-un')
	},
	{
		class: 'title-xl',
		sample: __('Three ways to grow your site.', 'wp-cinquante-et-un')
	},
	{
		class: 'title-lg',
		sample: __('Maintenance and evolutions', 'wp-cinquante-et-un')
	},
	{
		class: 'title-md',
		sample: __('Shopify storefront', 'wp-cinquante-et-un')
	}
] -%}

{%- set texts = [
	{
		class: 'text-xl',
		sample: __('Your site is not an expense to write off every three years.', 'wp-cinquante-et-un')
	},
	{
		class: 'text-lg',
		sample: __(
			'It is an asset you build to last, and you evolve it with the company.',
			'wp-cinquante-et-un'
		)
	},
	{
		class: 'text-base',
		sample: __('Dedicated theme, D2C and B2B, CRM connected from day one.', 'wp-cinquante-et-un')
	},
	{
		class: 'text-sm',
		sample: __('Fast, maintainable WordPress brochure and editorial sites.', 'wp-cinquante-et-un')
	},
	{
		class: 'text-xs',
		sample: __('Paris, Tours, Marseille', 'wp-cinquante-et-un')
	}
] -%}

{%- set metas = [
	{
		class: 'eyebrow',
		sample: __('What we do', 'wp-cinquante-et-un')
	},
	{
		class: 'label',
		sample: __('01/03 - Work', 'wp-cinquante-et-un')
	},
	{
		class: 'cta',
		sample: __('Talk about your project', 'wp-cinquante-et-un')
	},
	{
		class: 'badge',
		sample: __('Tier 2', 'wp-cinquante-et-un')
	}
] -%}

{%- set radii = [
	{
		name: '5',
		class: 'rounded-5'
	},
	{
		name: '6',
		class: 'rounded-6'
	},
	{
		name: '10',
		class: 'rounded-10'
	},
	{
		name: '15',
		class: 'rounded-15'
	},
	{
		name: '20',
		class: 'rounded-20'
	},
	{
		name: '25',
		class: 'rounded-25'
	},
	{
		name: '35',
		class: 'rounded-35'
	},
	{
		name: '50',
		class: 'rounded-50'
	}
] -%}

{%- set icons = [
	'arrow-left',
	'arrow-right',
	'bars',
	'bullet',
	'chevron-down',
	'chevron-left',
	'chevron-right',
	'envelope',
	'facebook',
	'globe',
	'instagram',
	'linkedin',
	'mark',
	'minus',
	'plus',
	'search',
	'times',
	'vimeo',
	'x',
	'youtube'
] -%}

<section class="space-y-8" aria-labelledby="styleguide-colors">
	<header class="space-y-2">
		<p class="eyebrow">
			{{- __('Color', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-colors" class="title-lg">{{- __('Palette', 'wp-cinquante-et-un') -}}</h2>
		<p class="text-muted max-w-prose text-sm">
			{{-
				__(
					'Dark mono theme. Depth comes from four blacks; pistachio is the only accent (CTAs, nodes, active links, focus). Do not use text-subtle on bg-card (contrast drops below AA).',
					'wp-cinquante-et-un'
				)
			-}}
		</p>
	</header>
	<div class="space-y-10">
		{%- for group in color_groups -%}
			<div class="space-y-4">
				<p class="eyebrow">
					{{ group.title }}
				</p>
				<ul class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5">
					{%- for color in group.colors -%}
						<li class="space-y-2">
							<div class="{{ color.class }} border-border aspect-square rounded-10 border"></div>
							<p class="label">
								{{ color.name }}
							</p>
							<p class="font-mono text-xs text-muted">
								.{{ color.class }}
							</p>
							<p class="font-mono text-xs text-subtle">
								{{ color.token }}
							</p>
						</li>
					{%- endfor -%}
				</ul>
			</div>
		{%- endfor -%}
	</div>
</section>

<section class="space-y-8" aria-labelledby="styleguide-type">
	<header class="space-y-2">
		<p class="eyebrow">
			{{- __('Typography', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-type" class="title-lg">{{- __('Type scale', 'wp-cinquante-et-un') -}}</h2>
	</header>

	<div class="space-y-10">
		<div class="space-y-4">
			<p class="label">
				{{- __('Titles', 'wp-cinquante-et-un') -}}
			</p>
			<ul class="divide-border-subtle divide-y">
				{%- for item in titles -%}
					<li class="space-y-2 py-5">
						<p class="label">
							.{{ item.class }}
						</p>
						<p class="{{ item.class }}">
							{{ item.sample }}
						</p>
					</li>
				{%- endfor -%}
			</ul>
		</div>

		<div class="space-y-4">
			<p class="label">
				{{- __('Text', 'wp-cinquante-et-un') -}}
			</p>
			<ul class="divide-border-subtle divide-y">
				{%- for item in texts -%}
					<li class="space-y-2 py-5">
						<p class="label">
							.{{ item.class }}
						</p>
						<p class="{{ item.class }}">
							{{ item.sample }}
						</p>
					</li>
				{%- endfor -%}
			</ul>
		</div>

		<div class="space-y-4">
			<p class="label">
				{{- __('Meta', 'wp-cinquante-et-un') -}}
			</p>
			<ul class="divide-border-subtle divide-y">
				{%- for item in metas -%}
					<li class="space-y-2 py-5">
						<p class="label">
							.{{ item.class }}
						</p>
						<p class="{{ item.class }}">
							{{ item.sample }}
						</p>
					</li>
				{%- endfor -%}
			</ul>
		</div>
	</div>
</section>

<section class="space-y-8" aria-labelledby="styleguide-radius">
	<header class="space-y-2">
		<p class="eyebrow">
			{{- __('Radius', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-radius" class="title-lg">{{- __('Corners', 'wp-cinquante-et-un') -}}</h2>
	</header>
	<ul class="flex flex-wrap items-end gap-5">
		{%- for radius in radii -%}
			<li class="space-y-2 text-center">
				<div class="bg-accent size-20 {{ radius.class }}"></div>
				<p class="label">
					.{{ radius.class }}
				</p>
			</li>
		{%- endfor -%}
	</ul>
</section>

