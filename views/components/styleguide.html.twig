		-%}
		{%- set switch_classes =
			'inline-flex cursor-pointer items-center gap-3 text-sm font-medium focus-visible:outline focus-visible:outline-offset-2 [&[aria-checked=true]_.thumb]:translate-x-4 [&[aria-checked=true]_.track]:border-default [&[aria-checked=true]_.track]:bg-inverse'
		-%}

		<div class="space-y-16">
			<div class="space-y-6" id="styleguide-ui-drawer">
				<header class="space-y-2">
					<h3 class="text-xl font-semibold">{{- __( 'Drawer', 'wp-cinquante-et-un' ) -}}</h3>
					<p class="max-w-prose text-sm text-secondary">
						{{-
							__(
								'Off-canvas native dialog in cinq-drawer, opened by a commandfor button (invoker commands).',
								'wp-cinquante-et-un'
							)
						-}}
					</p>
					<p class="font-mono text-xs text-secondary">
						@agencecinq/drawer · components/drawer.html.twig
					</p>
				</header>
				<div class="border border-default p-6">
					{{-
						include(
							'components/button.html.twig',
							{
								title: __( 'Open drawer', 'wp-cinquante-et-un' ),
								attributes: {
									commandfor: 'styleguide-drawer',
									command: 'show-modal',
								},
							},
							with_context: false
						)
					-}}
					{% embed 'components/drawer.html.twig'
						with {
							id: 'styleguide-drawer',
							direction: 'from-right',
							aria_label: __( 'Styleguide drawer', 'wp-cinquante-et-un' ),
						}
					%}
						{% block content %}
							<div class="space-y-3 p-5">
								<p class="text-xl font-semibold">{{- __( 'Drawer', 'wp-cinquante-et-un' ) -}}</p>
								<p class="text-sm text-secondary">
									{{-
										__(
											'Slide-over navigation or filters. Close with Escape, the backdrop or the button.',
											'wp-cinquante-et-un'
										)
									-}}
								</p>
								{{-
									include(
										'components/button.html.twig',
										{
											title: __( 'Close', 'wp-cinquante-et-un' ),
											variant: 'secondary',
											attributes: {
												commandfor: 'styleguide-drawer',
												command: 'request-close',
											},
										},
										with_context: false
									)
								-}}
							</div>
						{% endblock %}
					{% endembed %}
				</div>
			</div>

			<div class="space-y-6" id="styleguide-ui-modal">
				<header class="space-y-2">
					<h3 class="text-xl font-semibold">{{- __( 'Modal', 'wp-cinquante-et-un' ) -}}</h3>
					<p class="max-w-prose text-sm text-secondary">
						{{-
							__(
								'Native dialog in cinq-modal, opened by a commandfor button (invoker commands).',
								'wp-cinquante-et-un'
							)
						-}}
					</p>
					<p class="font-mono text-xs text-secondary">
						@agencecinq/modal · components/modal.html.twig
					</p>
				</header>
				<div class="border border-default p-6">
					{{-
						include(
							'components/button.html.twig',
							{
								title: __( 'Open modal', 'wp-cinquante-et-un' ),
								attributes: {
									commandfor: 'styleguide-modal',
									command: 'show-modal',
								},
							},
							with_context: false
						)
					-}}
					{% embed 'components/modal.html.twig'
						with {
							id: 'styleguide-modal',
							title: __( 'Modal', 'wp-cinquante-et-un' ),
						}
					%}
						{% block content %}
							<div class="space-y-3">
								<p class="text-sm text-secondary">
									{{-
										__(
											'The page is inert while it is open, a backdrop click closes it. Use for confirmations or compact forms.',
											'wp-cinquante-et-un'
										)
									-}}
								</p>
							</div>
						{% endblock %}
					{% endembed %}
				</div>
			</div>

			<div class="space-y-6" id="styleguide-ui-tabs">
				<header class="space-y-2">
					<h3 class="text-xl font-semibold">{{- __( 'Tabs', 'wp-cinquante-et-un' ) -}}</h3>
					<p class="max-w-prose text-sm text-secondary">
						{{-
							__(
								'Keyboard navigable tablist. Active tab mirrors the secondary button pattern.',
								'wp-cinquante-et-un'
							)
						-}}
					</p>
					<p class="font-mono text-xs text-secondary">@agencecinq/tabs</p>
				</header>
				<div class="border border-default p-6">
					<cinq-tabs class="block space-y-6" data-hash="false">
						<div
							class="flex flex-wrap gap-2"
							role="tablist"
							aria-label="{{ __( 'Styleguide tabs', 'wp-cinquante-et-un' ) }}"
						>
							<button
								type="button"
								class="is-active {{ tab_classes }}"
								role="tab"
								aria-selected="true"
								aria-controls="styleguide-tab-one"
								id="styleguide-tab-btn-one"
							>
								{{- __( 'One', 'wp-cinquante-et-un' ) -}}
							</button>
							<button
								type="button"
								class="{{ tab_classes }}"
								role="tab"
								aria-selected="false"
								aria-controls="styleguide-tab-two"
								id="styleguide-tab-btn-two"
								tabindex="-1"
							>
								{{- __( 'Two', 'wp-cinquante-et-un' ) -}}
							</button>
							<button
								type="button"
								class="{{ tab_classes }}"
								role="tab"
								aria-selected="false"
								aria-controls="styleguide-tab-three"
								id="styleguide-tab-btn-three"
								tabindex="-1"
							>
								{{- __( 'Three', 'wp-cinquante-et-un' ) -}}
							</button>
						</div>
						<section
							class="is-active text-sm text-secondary"
							tabindex="0"
							role="tabpanel"
							aria-labelledby="styleguide-tab-btn-one"
							id="styleguide-tab-one"
						>
							{{- __( 'First panel. Arrow keys move between tabs.', 'wp-cinquante-et-un' ) -}}
						</section>
						<section
							class="text-sm text-secondary"
							tabindex="0"
							role="tabpanel"
							aria-labelledby="styleguide-tab-btn-two"
							id="styleguide-tab-two"
							hidden
						>
							{{- __( 'Second panel.', 'wp-cinquante-et-un' ) -}}
						</section>
						<section
							class="text-sm text-secondary"
							tabindex="0"
							role="tabpanel"
							aria-labelledby="styleguide-tab-btn-three"
							id="styleguide-tab-three"
							hidden
						>
							{{- __( 'Third panel.', 'wp-cinquante-et-un' ) -}}
						</section>
					</cinq-tabs>
				</div>
			</div>

			<div class="space-y-6" id="styleguide-ui-accordion">
				<header class="space-y-2">
					<h3 class="text-xl font-semibold">{{- __( 'Accordion', 'wp-cinquante-et-un' ) -}}</h3>
					<p class="max-w-prose text-sm text-secondary">
						{{-
							__(
								'JS accordion from CINQ UI. Production FAQ blocks use the native details/summary component instead.',
								'wp-cinquante-et-un'
							)
						-}}
					</p>
					<p class="font-mono text-xs text-secondary">
						@agencecinq/accordion · components/accordion-group.html.twig
					</p>
				</header>
				<div class="max-w-prose border border-default p-6">
					<cinq-accordion class="block border-t border-field" data-hash="false">
						<div
							class="border-b border-field py-6 data-[open=true]:flex data-[open=true]:flex-col data-[open=true]:gap-4"
							data-panel
							data-open="true"
							data-deselectable="true"
						>
							<button
								type="button"
								class="flex w-full cursor-pointer items-center justify-between gap-4 text-left text-sm font-semibold"
								data-header
								id="styleguide-acc-1-header"
								aria-expanded="true"
								aria-controls="styleguide-acc-1-body"
							>
								<span class="min-w-0 flex-1">
									{{- __( 'Why do you publish your prices?', 'wp-cinquante-et-un' ) -}}
								</span>
								<span
									class="relative flex size-8 shrink-0 items-center justify-center bg-surface"
									aria-hidden="true"
								>
									<span class="in-data-[open=true]:hidden">
										{{-
											include(
												'svg/use.html.twig',
												{
													classes: [ 'size-3' ],
													icon: 'plus',
												},
												with_context: false
											)
										-}}
									</span>
									<span class="hidden in-data-[open=true]:block">
										{{-
											include(
												'svg/use.html.twig',
												{
													classes: [ 'size-3' ],
													icon: 'minus',
												},
												with_context: false
											)
										-}}
									</span>
								</span>
							</button>
							<div
								id="styleguide-acc-1-body"
								role="region"
								aria-labelledby="styleguide-acc-1-header"
							>
								<div class="text-sm text-secondary" data-inner>
									{{-
										__(
											'A web build has a scope and a cost. Hiding them until the third meeting only buys time to get attached. Our bases run from 12 900 to 36 900 euros. The full grid is public.',
											'wp-cinquante-et-un'
										)
									-}}
								</div>
							</div>
						</div>
						<div
							class="border-b border-field py-6 data-[open=true]:flex data-[open=true]:flex-col data-[open=true]:gap-4"
							data-panel
							data-open="false"
							data-deselectable="true"
						>
							<button
								type="button"
								class="flex w-full cursor-pointer items-center justify-between gap-4 text-left text-sm font-semibold"
								data-header
								id="styleguide-acc-2-header"
								aria-expanded="false"
								aria-controls="styleguide-acc-2-body"
							>
								<span class="min-w-0 flex-1">
									{{- __( 'What happens if the scope moves mid-build?', 'wp-cinquante-et-un' ) -}}
								</span>
								<span
									class="relative flex size-8 shrink-0 items-center justify-center bg-surface"
									aria-hidden="true"
								>
									<span class="in-data-[open=true]:hidden">
										{{-
											include(
												'svg/use.html.twig',
												{
													classes: [ 'size-3' ],
													icon: 'plus',
												},
												with_context: false
											)
										-}}
									</span>
									<span class="hidden in-data-[open=true]:block">
										{{-
											include(
												'svg/use.html.twig',
												{
													classes: [ 'size-3' ],
													icon: 'minus',
												},
												with_context: false
											)
										-}}
									</span>
								</span>
							</button>
							<div
								id="styleguide-acc-2-body"
								role="region"
								aria-labelledby="styleguide-acc-2-header"
								hidden
							>
								<div class="text-sm text-secondary" data-inner>
									{{-
										__(
											'We reopen the estimate, agree on the extra, then we build.',
											'wp-cinquante-et-un'
										)
									-}}
								</div>
							</div>
						</div>
					</cinq-accordion>
				</div>
			</div>

			<div class="space-y-6" id="styleguide-ui-disclosure">
				<header class="space-y-2">
					<h3 class="text-xl font-semibold">{{- __( 'Disclosure', 'wp-cinquante-et-un' ) -}}</h3>
					<p class="max-w-prose text-sm text-secondary">
						{{-
							__(
								'Toggle visibility of a single region. Wrap any button markup.',
								'wp-cinquante-et-un'
							)
						-}}
					</p>
					<p class="font-mono text-xs text-secondary">@agencecinq/disclosure-button</p>
				</header>
				<div class="space-y-3 border border-default p-6">
					<cinq-disclosure-button class="block">
						{{-
							include(
								'components/button.html.twig',
								{
									title: __( 'Show more', 'wp-cinquante-et-un' ),
									variant: 'tertiary',
									attributes: {
										'aria-expanded': 'false',
										'aria-controls': 'styleguide-disclosure',
									},
								},
								with_context: false
							)
						-}}
					</cinq-disclosure-button>
					<div class="text-sm text-secondary" id="styleguide-disclosure" hidden>
						{{- __( 'Hidden until the disclosure button opens it.', 'wp-cinquante-et-un' ) -}}
					</div>
				</div>
			</div>

			<div class="space-y-6" id="styleguide-ui-switch">
				<header class="space-y-2">
					<h3 class="text-xl font-semibold">{{- __( 'Switch', 'wp-cinquante-et-un' ) -}}</h3>
					<p class="max-w-prose text-sm text-secondary">
						{{-
							__(
								'Binary toggle with role="switch". Square track matches the starter radius.',
								'wp-cinquante-et-un'
							)
						-}}
					</p>
					<p class="font-mono text-xs text-secondary">@agencecinq/switch</p>
				</header>
				<div class="border border-default p-6">
					<div
						class="flex flex-wrap items-center gap-8"
						role="group"
						aria-label="{{ __( 'Switches', 'wp-cinquante-et-un' ) }}"
					>
						<cinq-switch
							class="{{ switch_classes }}"
							name="notifications"
							value="on"
							role="switch"
							aria-checked="false"
							tabindex="0"
						>
							<span>{{- __( 'Notifications', 'wp-cinquante-et-un' ) -}}</span>
							<span
								class="track relative block h-6 w-10 border border-field bg-media"
								aria-hidden="true"
							>
								<span
									class="thumb absolute top-0 left-0 block size-5 border border-default bg-page transition-transform"
								>
								</span>
							</span>
						</cinq-switch>
						<cinq-switch
							class="{{ switch_classes }} opacity-40"
							role="switch"
							aria-checked="false"
							disabled
						>
							<span>{{- __( 'Disabled', 'wp-cinquante-et-un' ) -}}</span>
							<span
								class="track relative block h-6 w-10 border border-field bg-media"
								aria-hidden="true"
							>
								<span
									class="thumb absolute top-0 left-0 block size-5 border border-default bg-page transition-transform"
								>
								</span>
							</span>
						</cinq-switch>
					</div>
				</div>
			</div>

			<div class="space-y-6" id="styleguide-ui-spinbutton">
				<header class="space-y-2">
					<h3 class="text-xl font-semibold">{{- __( 'Spin button', 'wp-cinquante-et-un' ) -}}</h3>
					<p class="max-w-prose text-sm text-secondary">
						{{-
							__(
								'Increment and decrement a numeric value with keyboard support.',
								'wp-cinquante-et-un'
							)
						-}}
					</p>
					<p class="font-mono text-xs text-secondary">@agencecinq/spinbutton</p>
				</header>
				<div class="border border-default p-6">
					<cinq-spinbutton
						class="inline-flex w-fit items-center gap-0 border border-default bg-surface p-1 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-focus-ring"
					>
						<button
							class="grid size-8 place-items-center bg-page hover:bg-surface disabled:cursor-not-allowed disabled:opacity-40"
							name="decrease"
							type="button"
							aria-label="{{ __( 'Decrease', 'wp-cinquante-et-un' ) }}"
							tabindex="-1"
						>
							{{-
								include(
									'svg/use.html.twig',
									{
										icon: 'minus',
										classes: [ 'size-4' ],
									},
									with_context: false
								)
							-}}
						</button>
						<input
							class="w-14 bg-transparent text-center text-sm font-medium focus:outline-none"
							type="number"
							aria-label="{{ __( 'Quantity', 'wp-cinquante-et-un' ) }}"
							aria-valuemin="0"
							aria-valuemax="10"
							aria-valuenow="1"
							value="1"
						/>
						<button
							class="grid size-8 place-items-center bg-page hover:bg-surface disabled:cursor-not-allowed disabled:opacity-40"
							name="increase"
							type="button"
							aria-label="{{ __( 'Increase', 'wp-cinquante-et-un' ) }}"
							tabindex="-1"
						>
							{{-
								include(
									'svg/use.html.twig',
									{
										icon: 'plus',
										classes: [ 'size-4' ],
									},
									with_context: false
								)
							-}}
						</button>
					</cinq-spinbutton>
				</div>
			</div>

			<div class="space-y-6" id="styleguide-ui-combobox">
				<header class="space-y-2">
					<h3 class="text-xl font-semibold">{{- __( 'Combobox', 'wp-cinquante-et-un' ) -}}</h3>
					<p class="max-w-prose text-sm text-secondary">
						{{-
							__(
								'Autocomplete listbox. Options are filled from JavaScript in styleguide.ts.',
								'wp-cinquante-et-un'
							)
						-}}
					</p>
					<p class="font-mono text-xs text-secondary">
						@agencecinq/combobox · src/scripts/styleguide.ts
					</p>
				</header>
				<div class="max-w-xs border border-default p-6">
					<label class="block subtitle" for="styleguide-city">
						{{- __( 'City', 'wp-cinquante-et-un' ) -}}
					</label>
					<cinq-combobox
						id="styleguide-city-combobox"
						class="relative mt-3 flex"
						data-open-on-empty="true"
						data-autoselect="true"
					>
						<input
							class="min-w-0 flex-1 border border-default px-3 py-2 text-sm font-medium"
							id="styleguide-city"
							type="text"
							role="combobox"
							aria-autocomplete="list"
							aria-expanded="false"
							aria-controls="styleguide-city-listbox"
							autocomplete="off"
						/>
						<button
							class="-ml-px flex size-10 shrink-0 items-center justify-center border border-default bg-page hover:bg-surface"
							type="button"
							tabindex="-1"
							aria-label="{{ __( 'Cities', 'wp-cinquante-et-un' ) }}"
							aria-controls="styleguide-city-listbox"
							aria-expanded="false"
						>
							{{-
								include(
									'svg/use.html.twig',
									{
										icon: 'chevron-down',
										classes: [ 'size-4' ],
									},
									with_context: false
								)
							-}}
						</button>
						<ul
							class="z-2 border border-field bg-page **:[[role=option]]:cursor-pointer **:[[role=option]]:px-3 **:[[role=option]]:py-2 **:[[role=option][aria-selected=true]]:bg-inverse **:[[role=option][aria-selected=true]]:text-inverse"
							id="styleguide-city-listbox"
							role="listbox"
							aria-label="{{ __( 'Cities', 'wp-cinquante-et-un' ) }}"
							hidden
						></ul>
					</cinq-combobox>
				</div>
			</div>
		</div>
	</section>
</div>
