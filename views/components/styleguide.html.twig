{#
 # Styleguide catalog: colors, type, space, layout, radius, buttons, chips, icons, image, teasers, pagination, WYSIWYG, CINQ UI.
 #}

{%- set primitives = [
	{ name: 'white', class: 'bg-white', token: '--color-white' },
	{ name: 'black', class: 'bg-black', token: '--color-black' },
	{ name: 'ink', class: 'bg-ink', token: '--color-ink' },
	{ name: 'gray-50', class: 'bg-gray-50', token: '--color-gray-50' },
	{ name: 'gray-100', class: 'bg-gray-100', token: '--color-gray-100' },
	{ name: 'gray-200', class: 'bg-gray-200', token: '--color-gray-200' },
	{ name: 'gray-300', class: 'bg-gray-300', token: '--color-gray-300' },
	{ name: 'gray-400', class: 'bg-gray-400', token: '--color-gray-400' },
	{ name: 'gray-500', class: 'bg-gray-500', token: '--color-gray-500' },
	{ name: 'gray-600', class: 'bg-gray-600', token: '--color-gray-600' },
	{ name: 'gray-700', class: 'bg-gray-700', token: '--color-gray-700' },
	{ name: 'gray-800', class: 'bg-gray-800', token: '--color-gray-800' },
	{ name: 'gray-900', class: 'bg-gray-900', token: '--color-gray-900' },
	{ name: 'red-700', class: 'bg-red-700', token: '--color-red-700' }
] -%}

{%- set scheme_roles = [
	{ name: 'background', class: 'bg-background', hint: __('Section background', 'wp-cinquante-et-un') },
	{ name: 'foreground', class: 'bg-foreground', hint: __('Text', 'wp-cinquante-et-un') },
	{ name: 'button', class: 'bg-button', hint: __('Primary button', 'wp-cinquante-et-un') },
	{ name: 'button-text', class: 'bg-button-text', hint: __('Button label', 'wp-cinquante-et-un') },
	{ name: 'secondary-button', class: 'bg-secondary-button', hint: __('Secondary button', 'wp-cinquante-et-un') },
	{ name: 'secondary-button-text', class: 'bg-secondary-button-text', hint: __('Secondary label', 'wp-cinquante-et-un') },
	{ name: 'link', class: 'bg-link', hint: __('Editorial links', 'wp-cinquante-et-un') },
	{ name: 'badge-background', class: 'bg-badge-background', hint: __('Tag background', 'wp-cinquante-et-un') },
	{ name: 'badge-foreground', class: 'bg-badge-foreground', hint: __('Tag text', 'wp-cinquante-et-un') },
	{ name: 'badge-border', class: 'bg-badge-border', hint: __('Tag border', 'wp-cinquante-et-un') }
] -%}

{%- set ui_tokens = [
	{ name: 'surface', class: 'bg-white', token: '--color-white' },
	{ name: 'surface-muted', class: 'bg-gray-100', token: '--color-gray-100' },
	{ name: 'border-default', class: 'border-black', token: '--color-black' },
	{ name: 'border-muted', class: 'border-gray-200', token: '--color-gray-200' },
	{ name: 'text-default', class: 'text-black', token: '--color-black' },
	{ name: 'text-muted', class: 'text-gray-500', token: '--color-gray-500' },
	{ name: 'text-subtle', class: 'text-gray-600', token: '--color-gray-600' },
	{ name: 'text-inverse', class: 'text-white bg-black', token: '--color-white' },
	{ name: 'text-error', class: 'text-red-700', token: '--color-red-700' }
] -%}

{%- set type_scale = [
	{ name: 'Display/6xl', class: 'text-6xl font-semibold', sample: __('Hero title', 'wp-cinquante-et-un'), note: __('Editorial', 'wp-cinquante-et-un') },
	{ name: 'Display/5xl', class: 'text-5xl font-semibold', sample: __('Hero title', 'wp-cinquante-et-un'), note: __('Editorial', 'wp-cinquante-et-un') },
	{ name: 'Display/4xl', class: 'text-4xl font-semibold', sample: __('Page title', 'wp-cinquante-et-un') },
	{ name: 'Display/3xl', class: 'text-3xl font-semibold', sample: __('Page title', 'wp-cinquante-et-un') },
	{ name: 'Heading/2xl', class: 'text-2xl font-semibold', sample: __('Block title', 'wp-cinquante-et-un') },
	{ name: 'Heading/xl', class: 'text-xl font-semibold', sample: __('Subtitle', 'wp-cinquante-et-un') },
	{ name: 'Heading/xl', class: 'text-xl font-medium', sample: __('Subtitle', 'wp-cinquante-et-un') },
	{ name: 'Body/lg', class: 'text-lg', sample: __('Block lead', 'wp-cinquante-et-un') },
	{ name: 'Body/base', class: 'text-base', sample: __('Interface text', 'wp-cinquante-et-un') },
	{ name: 'Body/base', class: 'text-base font-medium', sample: __('Interface text', 'wp-cinquante-et-un') },
	{ name: 'Body/sm', class: 'text-sm', sample: __('Secondary text', 'wp-cinquante-et-un') },
	{ name: 'Body/sm', class: 'text-sm font-medium', sample: __('Secondary text', 'wp-cinquante-et-un') },
	{ name: 'Body/sm', class: 'text-sm font-semibold', sample: __('Secondary text', 'wp-cinquante-et-un') },
	{ name: 'Label/xs', class: 'text-xs', sample: __('Label', 'wp-cinquante-et-un') },
	{ name: 'Label/xs', class: 'text-xs font-medium', sample: __('Label', 'wp-cinquante-et-un') },
	{ name: 'Label/xs', class: 'text-xs font-semibold', sample: __('Label', 'wp-cinquante-et-un') },
	{ name: 'Eyebrow', class: 'subtitle', sample: __('Block overline', 'wp-cinquante-et-un') },
	{ name: 'Prose/lg', class: 'prose-lg', sample: __('Article lead', 'wp-cinquante-et-un'), note: __('Editorial, line-height 1.7', 'wp-cinquante-et-un') },
	{ name: 'Prose/base', class: 'prose-base', sample: __('Article body', 'wp-cinquante-et-un'), note: __('Editorial, line-height 1.7', 'wp-cinquante-et-un') },
	{ name: 'Prose/base', class: 'prose-base font-bold', sample: __('Highlighted passage', 'wp-cinquante-et-un'), note: __('Editorial, weight 700', 'wp-cinquante-et-un') }
] -%}

{%- set spacings = [
	{ step: 1, class: 'w-1', px: 4 },
	{ step: 2, class: 'w-2', px: 8 },
	{ step: 3, class: 'w-3', px: 12 },
	{ step: 4, class: 'w-4', px: 16 },
	{ step: 5, class: 'w-5', px: 20 },
	{ step: 6, class: 'w-6', px: 24 },
	{ step: 8, class: 'w-8', px: 32 },
	{ step: 10, class: 'w-10', px: 40 },
	{ step: 12, class: 'w-12', px: 48 },
	{ step: 16, class: 'w-16', px: 64 },
	{ step: 20, class: 'w-20', px: 80 },
	{ step: 24, class: 'w-24', px: 96, note: __('Editorial', 'wp-cinquante-et-un') },
	{ step: 28, class: 'w-28', px: 112, note: __('Editorial', 'wp-cinquante-et-un') },
	{ step: 32, class: 'w-32', px: 128, note: __('Editorial', 'wp-cinquante-et-un') }
] -%}

{%- set section_spacings = [
	{ name: 'none', desktop: 0, mobile: 0, desktop_class: 'w-px', mobile_class: 'w-px' },
	{ name: 'sm', desktop: 32, mobile: 24, desktop_class: 'w-8', mobile_class: 'w-6' },
	{ name: 'md', desktop: 64, mobile: 40, desktop_class: 'w-16', mobile_class: 'w-10' },
	{ name: 'lg', desktop: 96, mobile: 56, desktop_class: 'w-24', mobile_class: 'w-14' },
	{ name: 'xl', desktop: 128, mobile: 72, desktop_class: 'w-32', mobile_class: 'w-18' }
] -%}

{%- set icons = [
	'arrow-left',
	'arrow-right',
	'bars',
	'calendar',
	'check',
	'chevron-down',
	'chevron-left',
	'chevron-right',
	'facebook',
	'instagram',
	'minus',
	'plus',
	'search',
	'times',
	'quote',
	'mail',
	'phone',
	'map-pin',
	'linkedin',
	'twitter',
	'youtube'
] -%}
{%- set extra_icons = [
	'mark',
	'vimeo',
	'x'
] -%}

<section class="space-y-8" aria-labelledby="styleguide-colors">
	<header class="space-y-2">
		<p class="subtitle">
			{{- __('Foundations', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-colors" class="text-2xl font-semibold">
			{{- __('Colour', 'wp-cinquante-et-un') -}}
		</h2>
		<p class="text-gray-500 max-w-prose text-sm">
			{{-
				__(
					'Tailwind v4 primitives (plus ink). Never pick primitives in the editor. Blocks switch Light or Inverse via ACF color_scheme. UI components read the Tailwind layer below, not the schemes.',
					'wp-cinquante-et-un'
				)
			-}}
		</p>
	</header>
	<div class="space-y-10">
		<div class="space-y-4">
			<p class="subtitle">
				{{- __('Primitives', 'wp-cinquante-et-un') -}}
			</p>
			<ul class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-7">
				{%- for color in primitives -%}
					<li class="space-y-2">
						<div class="{{ color.class }} aspect-square border border-gray-200"></div>
						<p class="text-xs font-medium">
							{{ color.name }}
						</p>
						<p class="text-gray-500 text-xs">
							.{{ color.class }}
						</p>
						<p class="text-gray-500 text-xs">
							{{ color.token }}
						</p>
					</li>
				{%- endfor -%}
			</ul>
		</div>
		<div class="space-y-4">
			<p class="subtitle">
				{{- __('Color schemes', 'wp-cinquante-et-un') -}}
			</p>
			<p class="text-gray-500 max-w-prose text-sm">
				{{-
					__(
						'Exposed in theme.json for Gutenberg. Each block sets color_scheme to default or inverse.',
						'wp-cinquante-et-un'
					)
				-}}
			</p>
			<div class="grid gap-6 lg:grid-cols-2">
				<div class="space-y-5 border border-black p-7" data-color-scheme="default">
					<p class="text-sm font-semibold">
						{{- __('Scheme 1 · Light', 'wp-cinquante-et-un') -}}
					</p>
					<ul class="grid grid-cols-2 gap-4 sm:grid-cols-3">
						{%- for color in scheme_roles -%}
							<li class="space-y-2">
								<div class="{{ color.class }} aspect-square border border-gray-200"></div>
								<p class="text-xs font-medium">
									{{ color.name }}
								</p>
								<p class="text-gray-500 text-xs">
									{{ color.hint }}
								</p>
							</li>
						{%- endfor -%}
					</ul>
				</div>
				<div class="bg-background text-foreground space-y-5 border border-black p-7" data-color-scheme="inverse">
					<p class="text-sm font-semibold">
						{{- __('Scheme 2 · Inverse', 'wp-cinquante-et-un') -}}
					</p>
					<ul class="grid grid-cols-2 gap-4 sm:grid-cols-3">
						{%- for color in scheme_roles -%}
							<li class="space-y-2">
								<div class="{{ color.class }} border-gray-200 aspect-square border"></div>
								<p class="text-xs font-medium">
									{{ color.name }}
								</p>
								<p class="text-xs opacity-70">
									{{ color.hint }}
								</p>
							</li>
						{%- endfor -%}
					</ul>
				</div>
			</div>
		</div>
		<div class="space-y-4">
			<p class="subtitle">
				{{- __('UI', 'wp-cinquante-et-un') -}}
			</p>
			<p class="text-gray-500 max-w-prose text-sm">
				{{-
					__(
						'Roles consumed by buttons and surfaces. They are Tailwind utilities, not extra tokens, and they do not follow a color scheme.',
						'wp-cinquante-et-un'
					)
				-}}
			</p>
			<ul class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5">
				{%- for color in ui_tokens -%}
					<li class="space-y-2">
						<div class="{{ color.class }} aspect-square border border-gray-200"></div>
						<p class="text-xs font-medium">
							{{ color.name }}
						</p>
						<p class="text-gray-500 text-xs">
							.{{ color.class }}
						</p>
						<p class="text-gray-500 text-xs">
							{{ color.token }}
						</p>
					</li>
				{%- endfor -%}
			</ul>
		</div>
	</div>
</section>

<section class="space-y-8" aria-labelledby="styleguide-type">
	<header class="space-y-2">
		<p class="subtitle">
			{{- __('Foundations', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-type" class="text-2xl font-semibold">
			{{- __('Type', 'wp-cinquante-et-un') -}}
		</h2>
		<p class="text-gray-500 max-w-prose text-sm">
			{{-
				__(
					'System sans-serif stack (ui-sans-serif, system-ui). Fifteen interface styles plus five editorial styles (5xl, 6xl, and Prose at line-height 1.7). Never use Prose in UI, nor Body in an article. .subtitle is uppercase with 0.1em tracking.',
					'wp-cinquante-et-un'
				)
			-}}
		</p>
	</header>
	<ul class="divide-gray-100 divide-y">
		{%- for item in type_scale -%}
			<li class="grid grid-cols-12 items-center gap-5 py-5">
				<div class="col-span-full space-y-1 sm:col-span-4">
					<p class="text-xs font-medium">
						{{ item.name }}
					</p>
					<p class="text-gray-500 text-xs">
						.{{ item.class }}
						{%- if item.note -%}
							{{ ' · ' }}{{ item.note }}
						{%- endif -%}
					</p>
				</div>
				<p class="{{ item.class }} col-span-full sm:col-span-8">
					{{ item.sample }}
				</p>
			</li>
		{%- endfor -%}
	</ul>
</section>

<section class="space-y-8" aria-labelledby="styleguide-space">
	<header class="space-y-2">
		<p class="subtitle">
			{{- __('Foundations', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-space" class="text-2xl font-semibold">
			{{- __('Space', 'wp-cinquante-et-un') -}}
		</h2>
		<p class="text-gray-500 max-w-prose text-sm">
			{{-
				__(
					'Tailwind spacing scale (0.25rem) for gutters and component padding, never between sections. Section spacing is a separate ACF scale of five values.',
					'wp-cinquante-et-un'
				)
			-}}
		</p>
	</header>
	<ul class="space-y-2">
		{%- for item in spacings -%}
			<li class="flex items-center gap-4 text-xs">
				<p class="w-24 font-medium">
					spacing/{{ item.step }}
				</p>
				<p class="text-gray-500 w-16">
					{{ item.px }}
				</p>
				<div class="bg-black h-4 {{ item.class }}"></div>
				<p class="text-gray-500">
					gap-{{ item.step }} · p-{{ item.step }}
					{%- if item.note -%}
						{{ ' · ' }}{{ item.note }}
					{%- endif -%}
				</p>
			</li>
		{%- endfor -%}
	</ul>
	<div class="space-y-4">
		<p class="subtitle">
			{{- __('Section spacing', 'wp-cinquante-et-un') -}}
		</p>
		<p class="text-gray-500 max-w-prose text-sm">
			{{-
				__(
					'The only values for ACF spacing_top and spacing_bottom. Desktop then mobile.',
					'wp-cinquante-et-un'
				)
			-}}
		</p>
		<ul class="space-y-2.5">
			{%- for item in section_spacings -%}
				<li class="flex items-center gap-5 text-xs">
					<p class="w-30 font-medium">
						section/{{ item.name }}
					</p>
					<p class="text-gray-500 w-24">
						{{ item.desktop }} / {{ item.mobile }}
					</p>
					<div class="bg-black h-4 {{ item.desktop_class }}"></div>
					<div class="bg-gray-200 h-4 {{ item.mobile_class }}"></div>
					<p class="text-gray-500">
						{{- __('desktop · mobile', 'wp-cinquante-et-un') -}}
					</p>
				</li>
			{%- endfor -%}
		</ul>
	</div>
</section>

<section class="space-y-8" aria-labelledby="styleguide-layout">
	<header class="space-y-2">
		<p class="subtitle">
			{{- __('Foundations', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-layout" class="text-2xl font-semibold">
			{{- __('Layout', 'wp-cinquante-et-un') -}}
		</h2>
		<p class="text-gray-500 max-w-prose text-sm">
			{{-
				__(
					'12-column grid. Container max-width is 1440px by default (set --container-max-width to 110rem for 1760px). Article body never exceeds 720px.',
					'wp-cinquante-et-un'
				)
			-}}
		</p>
	</header>
	<div class="bg-gray-100 grid grid-cols-12 gap-4 p-5">
		{%- for i in 1..12 -%}
			<div class="bg-gray-200 col-span-1 py-12"></div>
		{%- endfor -%}
	</div>
	<div class="flex h-14 w-full max-w-prose items-center justify-center border border-black">
		<p class="text-gray-600 text-xs">
			{{- __('layout/prose-max-width — 720px, about 65 characters. The measure for long copy.', 'wp-cinquante-et-un') -}}
		</p>
	</div>
	<ul class="grid grid-cols-1 gap-0 md:grid-cols-2 lg:grid-cols-4">
		<li class="space-y-2 border border-black p-5">
			<p class="text-gray-500 text-xs font-medium">
				{{- __('Breakpoints', 'wp-cinquante-et-un') -}}
			</p>
			<p class="text-base font-semibold">
				sm 640 · md 768 · lg 1024
			</p>
			<p class="text-gray-600 text-xs">
				{{- __('md is used here: editorial grids often go to two columns before lg.', 'wp-cinquante-et-un') -}}
			</p>
		</li>
		<li class="-ml-px space-y-2 border border-black p-5">
			<p class="text-gray-500 text-xs font-medium">
				{{- __('Container', 'wp-cinquante-et-un') -}}
			</p>
			<p class="text-base font-semibold">
				1440 / 1760 px
			</p>
			<p class="text-gray-600 text-xs">
				{{- __('Two modes. Override --container-max-width (90rem or 110rem) from the start.', 'wp-cinquante-et-un') -}}
			</p>
		</li>
		<li class="-ml-px space-y-2 border border-black p-5">
			<p class="text-gray-500 text-xs font-medium">
				{{- __('Editorial measure', 'wp-cinquante-et-un') -}}
			</p>
			<p class="text-base font-semibold">
				720 px
			</p>
			<p class="text-gray-600 text-xs">
				{{- __('Article body never exceeds this width, whatever the container.', 'wp-cinquante-et-un') -}}
			</p>
		</li>
		<li class="-ml-px space-y-2 border border-black p-5">
			<p class="text-gray-500 text-xs font-medium">
				{{- __('Radius', 'wp-cinquante-et-un') -}}
			</p>
			<p class="text-base font-semibold">
				0
			</p>
			<p class="text-gray-600 text-xs">
				{{- __('Sharp corners, 1px borders.', 'wp-cinquante-et-un') -}}
			</p>
		</li>
	</ul>
</section>

<section class="space-y-8" aria-labelledby="styleguide-radius">
	<header class="space-y-2">
		<p class="subtitle">
			{{- __('Foundations', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-radius" class="text-2xl font-semibold">
			{{- __('Radius', 'wp-cinquante-et-un') -}}
		</h2>
		<p class="text-gray-500 max-w-prose text-sm">
			{{-
				__(
					'Radius is 0. Do not add rounded-* utilities in the starter.',
					'wp-cinquante-et-un'
				)
			-}}
		</p>
	</header>
	<div class="space-y-2">
		<div class="bg-black size-20"></div>
		<p class="text-xs font-medium">
			.rounded-none
		</p>
	</div>
</section>

<section class="space-y-8" aria-labelledby="styleguide-buttons">
	<header class="space-y-2">
		<p class="font-mono text-xs tracking-widest uppercase">
			{{- __('Components', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-buttons" class="text-2xl font-medium tracking-tight lg:text-3xl">
			{{- __('Buttons', 'wp-cinquante-et-un') -}}
		</h2>
	</header>

	<div class="space-y-8">
		<div class="space-y-4">
			<p class="font-mono text-xs tracking-widest">
				{{- __('Primary', 'wp-cinquante-et-un') -}}
			</p>
			<div class="flex flex-wrap items-center gap-4">
				{{-
					include(
						'components/button.html.twig',
						{
							title: __('Button', 'wp-cinquante-et-un')
						}
					)
				-}}
				{{-
					include(
						'components/button.html.twig',
						{
							title: __('Button', 'wp-cinquante-et-un'),
							icon: 'plus'
						}
					)
				-}}
				{{-
					include(
						'components/button.html.twig',
						{
							title: __('Button', 'wp-cinquante-et-un'),
							disabled: true
						}
					)
				-}}
			</div>
		</div>

		<div class="space-y-4">
			<p class="font-mono text-xs tracking-widest">
				{{- __('Secondary', 'wp-cinquante-et-un') -}}
			</p>
			<div class="flex flex-wrap items-center gap-4">
				{{-
					include(
						'components/button.html.twig',
						{
							title: __('Button', 'wp-cinquante-et-un'),
							variant: 'secondary'
						}
					)
				-}}
				{{-
					include(
						'components/button.html.twig',
						{
							title: __('Button', 'wp-cinquante-et-un'),
							variant: 'secondary',
							icon: 'plus'
						}
					)
				-}}
				{{-
					include(
						'components/button.html.twig',
						{
