						data-deselect="true"
					>
						<button
							type="button"
							class="flex w-full cursor-pointer items-center justify-between gap-4 text-left text-sm font-semibold"
							data-header
							id="styleguide-acc-2-header"
							aria-expanded="false"
							aria-controls="styleguide-acc-2-body"
						>
							<span class="min-w-0 flex-1">
								{{- __('What happens if the scope moves mid-build?', 'wp-cinquante-et-un') -}}
