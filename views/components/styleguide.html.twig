{%- set extra_icons = [ 'mark', 'vimeo', 'x' ] -%}

<div class="space-y-20">
	<section class="space-y-8" aria-labelledby="styleguide-colors">
		<header class="space-y-2">
			<p class="subtitle">{{- __( 'Foundations', 'wp-cinquante-et-un' ) -}}</p>
			<h2 id="styleguide-colors" class="text-2xl font-semibold">
				{{- __( 'Colour', 'wp-cinquante-et-un' ) -}}
			</h2>
			<p class="max-w-prose text-sm text-secondary">
				{{-
					__(
						'Palette and roles from includes/schemes.php, mirroring the Figma variables. Templates paint with the roles (text-primary, bg-surface, border-default…), never with the primitives. Blocks pick a color scheme via ACF color_scheme.',
						'wp-cinquante-et-un'
					)
				-}}
			</p>
		</header>
		<div class="space-y-10">
			<div class="space-y-4">
				<p class="subtitle">{{- __( 'Primitives', 'wp-cinquante-et-un' ) -}}</p>
				<ul class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-8">
					{%- for slug, color in cinq_palette() -%}
						<li class="space-y-2">
							<div
								class="aspect-square border border-field"
								style="background-color: var(--palette-{{ slug }})"
							></div>
							<p class="text-xs font-medium">{{- color.label -}}</p>
							<p class="text-xs text-secondary">--palette-{{ slug }} · {{ color.value }}</p>
						</li>
					{%- endfor -%}
				</ul>
			</div>
			<div class="space-y-4">
				<p class="subtitle">{{- __( 'Color schemes', 'wp-cinquante-et-un' ) -}}</p>
				<p class="max-w-prose text-sm text-secondary">
					{{-
						__(
							'Each block sets data-scheme from its ACF color_scheme: background and text follow, and every role takes the value of the scheme.',
							'wp-cinquante-et-un'
						)
					-}}
				</p>
				<div class="grid gap-6 lg:grid-cols-2">
					{%- for slug, scheme in cinq_schemes() -%}
						<div class="space-y-5 border border-default p-7" data-scheme="{{ slug }}">
							<p class="text-sm font-semibold">{{- scheme.label -}}</p>
							<p class="text-xs opacity-70">data-scheme="{{ slug }}"</p>
							<ul class="grid grid-cols-2 gap-4 sm:grid-cols-3">
								{%- for role, hint in cinq_scheme_roles() -%}
									<li class="space-y-2">
										<div
											class="aspect-square border border-current/20"
											style="background-color: var(--{{ role }})"
										></div>
										<p class="text-xs font-medium">{{- role -}}</p>
										<p class="text-xs opacity-70">{{- hint -}}</p>
									</li>
								{%- endfor -%}
							</ul>
						</div>
					{%- endfor -%}
				</div>
			</div>
		</div>
	</section>

	<section class="space-y-8" aria-labelledby="styleguide-type">
		<header class="space-y-2">
			<p class="subtitle">{{- __( 'Foundations', 'wp-cinquante-et-un' ) -}}</p>
			<h2 id="styleguide-type" class="text-2xl font-semibold">
				{{- __( 'Type', 'wp-cinquante-et-un' ) -}}
			</h2>
			<p class="max-w-prose text-sm text-secondary">
				{{-
					__(
						'System sans-serif stack (ui-sans-serif, system-ui). Fifteen interface styles plus five editorial styles (5xl, 6xl, and Prose at line-height 1.7). Never use Prose in UI, nor Body in an article. .subtitle is uppercase with 0.1em tracking.',
						'wp-cinquante-et-un'
					)
				-}}
			</p>
		</header>
		<ul class="divide-y divide-field">
			{%- for item in type_scale -%}
				<li class="grid grid-cols-12 items-center gap-5 py-5">
					<div class="col-span-full space-y-1 sm:col-span-4">
						<p class="text-xs font-medium">{{ item.name }}</p>
						<p class="text-xs text-secondary">
							.{{ item.class }}
							{%- if item.note -%}
								{{ ' · ' }}{{ item.note }}
							{%- endif -%}
						</p>
					</div>
					<p class="{{ item.class }} col-span-full sm:col-span-8">{{ item.sample }}</p>
				</li>
			{%- endfor -%}
		</ul>
	</section>

	<section class="space-y-8" aria-labelledby="styleguide-space">
		<header class="space-y-2">
			<p class="subtitle">{{- __( 'Foundations', 'wp-cinquante-et-un' ) -}}</p>
			<h2 id="styleguide-space" class="text-2xl font-semibold">
				{{- __( 'Space', 'wp-cinquante-et-un' ) -}}
			</h2>
			<p class="max-w-prose text-sm text-secondary">
				{{-
					__(
						'Tailwind spacing scale (0.25rem) for gutters and component padding, never between sections. Section spacing is a separate ACF scale of five values.',
						'wp-cinquante-et-un'
					)
				-}}
			</p>
		</header>
		<ul class="space-y-2">
			{%- for item in spacings -%}
				<li class="flex items-center gap-4 text-xs">
					<p class="w-24 font-medium">spacing/{{ item.step }}</p>
					<p class="w-16 text-secondary">{{ item.px }}</p>
					<div class="h-4 bg-inverse {{ item.class }}"></div>
					<p class="text-secondary">
						gap-{{ item.step }} · p-{{ item.step }}
						{%- if item.note -%}
							{{ ' · ' }}{{ item.note }}
						{%- endif -%}
					</p>
				</li>
			{%- endfor -%}
		</ul>
		<div class="space-y-4">
			<p class="subtitle">{{- __( 'Section spacing', 'wp-cinquante-et-un' ) -}}</p>
			<p class="max-w-prose text-sm text-secondary">
				{{-
					__(
						'The only values for ACF spacing_top and spacing_bottom. Desktop then mobile.',
						'wp-cinquante-et-un'
					)
				-}}
			</p>
			<ul class="space-y-2.5">
				{%- for item in section_spacings -%}
					<li class="flex items-center gap-5 text-xs">
						<p class="w-30 font-medium">section/{{ item.name }}</p>
						<p class="w-24 text-secondary">{{ item.desktop }} / {{ item.mobile }}</p>
						<div class="h-4 bg-inverse {{ item.desktop_class }}"></div>
						<div class="h-4 bg-media {{ item.mobile_class }}"></div>
						<p class="text-secondary">{{- __( 'desktop · mobile', 'wp-cinquante-et-un' ) -}}</p>
					</li>
				{%- endfor -%}
			</ul>
		</div>
	</section>

	<section class="space-y-8" aria-labelledby="styleguide-layout">
		<header class="space-y-2">
			<p class="subtitle">{{- __( 'Foundations', 'wp-cinquante-et-un' ) -}}</p>
			<h2 id="styleguide-layout" class="text-2xl font-semibold">
				{{- __( 'Layout', 'wp-cinquante-et-un' ) -}}
			</h2>
			<p class="max-w-prose text-sm text-secondary">
				{{-
					__(
						'12-column grid. Container max-width is 1440px by default (set --container-max-width to 110rem for 1760px). Article body never exceeds 720px.',
						'wp-cinquante-et-un'
					)
				-}}
			</p>
		</header>
		<div class="grid grid-cols-12 gap-4 bg-surface p-5">
			{%- for i in 1..12 -%}
				<div class="col-span-1 bg-media py-12"></div>
			{%- endfor -%}
		</div>
		<div class="flex h-14 w-full max-w-prose items-center justify-center border border-default">
			<p class="text-xs text-secondary">
				{{-
					__(
						'layout/prose-max-width: 720px, about 65 characters. The measure for long copy.',
						'wp-cinquante-et-un'
					)
				-}}
			</p>
		</div>
		<ul class="grid grid-cols-1 gap-0 md:grid-cols-2 lg:grid-cols-4">
			<li class="space-y-2 border border-default p-5">
				<p class="text-xs font-medium text-secondary">
					{{- __( 'Breakpoints', 'wp-cinquante-et-un' ) -}}
				</p>
				<p class="text-base font-semibold">sm 640 · md 768 · lg 1024</p>
				<p class="text-xs text-secondary">
					{{-
						__(
							'md is used here: editorial grids often go to two columns before lg.',
							'wp-cinquante-et-un'
						)
					-}}
				</p>
			</li>
			<li class="-ml-px space-y-2 border border-default p-5">
				<p class="text-xs font-medium text-secondary">
					{{- __( 'Container', 'wp-cinquante-et-un' ) -}}
				</p>
				<p class="text-base font-semibold">1440 / 1760 px</p>
				<p class="text-xs text-secondary">
					{{-
						__(
							'Two modes. Override --container-max-width (90rem or 110rem) from the start.',
							'wp-cinquante-et-un'
						)
					-}}
				</p>
			</li>
			<li class="-ml-px space-y-2 border border-default p-5">
				<p class="text-xs font-medium text-secondary">
					{{- __( 'Editorial measure', 'wp-cinquante-et-un' ) -}}
				</p>
				<p class="text-base font-semibold">720 px</p>
				<p class="text-xs text-secondary">
					{{-
						__(
							'Article body never exceeds this width, whatever the container.',
							'wp-cinquante-et-un'
						)
					-}}
				</p>
			</li>
			<li class="-ml-px space-y-2 border border-default p-5">
				<p class="text-xs font-medium text-secondary">
					{{- __( 'Radius', 'wp-cinquante-et-un' ) -}}
				</p>
				<p class="text-base font-semibold">0</p>
				<p class="text-xs text-secondary">
					{{- __( 'Sharp corners, 1px borders.', 'wp-cinquante-et-un' ) -}}
				</p>
			</li>
		</ul>
	</section>

	<section class="space-y-8" aria-labelledby="styleguide-radius">
		<header class="space-y-2">
			<p class="subtitle">{{- __( 'Foundations', 'wp-cinquante-et-un' ) -}}</p>
			<h2 id="styleguide-radius" class="text-2xl font-semibold">
				{{- __( 'Radius', 'wp-cinquante-et-un' ) -}}
			</h2>
			<p class="max-w-prose text-sm text-secondary">
				{{-
					__( 'Radius is 0. Do not add rounded-* utilities in the starter.', 'wp-cinquante-et-un' )
				-}}
			</p>
		</header>
		<div class="space-y-2">
			<div class="size-20 bg-inverse"></div>
			<p class="text-xs font-medium">.rounded-none</p>
		</div>
	</section>

	<section class="space-y-8" aria-labelledby="styleguide-buttons">
		<header class="space-y-3">
			<p class="subtitle">{{- __( 'Components', 'wp-cinquante-et-un' ) -}}</p>
			<h2 id="styleguide-buttons" class="text-2xl font-semibold">
				{{- __( 'Buttons', 'wp-cinquante-et-un' ) -}}
			</h2>
			<p class="font-mono text-xs text-secondary">
				components/button.html.twig · src/stylesheets/components/button.css
			</p>
		</header>

		<div class="space-y-8">
			<div class="space-y-4">
				<p class="font-mono text-xs tracking-widest">
					{{- __( 'Primary', 'wp-cinquante-et-un' ) -}}
				</p>
				<div class="flex flex-wrap items-center gap-4">
					{{-
						include(
							'components/button.html.twig',
							{ title: __( 'Button', 'wp-cinquante-et-un' ) }
