			{{-
				include(
					'components/skip-links.html.twig',
					{},
					with_context = false
				)
			-}}
		</div>
	</div>
</section>

<section class="space-y-20" aria-labelledby="styleguide-ui">
	<header class="space-y-3">
		<p class="subtitle">
			{{- __('CINQ UI', 'wp-cinquante-et-un') -}}
