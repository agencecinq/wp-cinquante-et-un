				<p class="font-mono text-xs text-gray-500">
					components/skip-links.html.twig
				</p>
			</header>
			<p class="text-gray-500 text-sm">
				{{-
					__(
						'Included once in the layout shell. Tab into the page to reveal the skip link.',
