						type="button"
						aria-label="{{ __('Increase', 'wp-cinquante-et-un') }}"
						tabindex="-1"
					>
						{{-
							include(
								'svg/use.html.twig',
								{
									icon: 'plus',
									classes: ['size-4']
								},
								with_context = false
							)
