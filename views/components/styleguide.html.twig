							aria-expanded="true"
							aria-controls="styleguide-acc-1-body"
						>
							<span class="min-w-0 flex-1">
								{{- __('Why do you publish your prices?', 'wp-cinquante-et-un') -}}
							</span>
							<span
								class="relative flex size-8 shrink-0 items-center justify-center bg-gray-100"
								aria-hidden="true"
							>
								<span class="in-data-[open=true]:hidden">
									{{-
										include(
											'svg/use.html.twig',
											{
												classes: ['size-3'],
												icon: 'plus'
											},
											with_context = false
										)
									-}}
								</span>
								<span class="hidden in-data-[open=true]:block">
									{{-
										include(
											'svg/use.html.twig',
											{
												classes: ['size-3'],
												icon: 'minus'
											},
											with_context = false
										)
									-}}
								</span>
							</span>
						</button>
						<div id="styleguide-acc-1-body" role="region" aria-labelledby="styleguide-acc-1-header">
							<div class="text-sm text-gray-600" data-inner>
								{{-
									__(
										'A web build has a scope and a cost. Hiding them until the third meeting only buys time to get attached. Our bases run from 12 900 to 36 900 euros. The full grid is public.',
										'wp-cinquante-et-un'
									)
								-}}
							</div>
						</div>
					</div>
					<div
						class="border-b border-gray-200 py-6 data-[open=true]:flex data-[open=true]:flex-col data-[open=true]:gap-4"
