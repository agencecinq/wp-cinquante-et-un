	{%- set tab_classes = 'border border-black px-4 py-3 text-xs font-medium transition-colors hover:bg-black hover:text-white [&.is-active]:bg-black [&.is-active]:text-white' -%}
	{%- set switch_classes = 'inline-flex cursor-pointer items-center gap-3 text-sm font-medium focus-visible:outline focus-visible:outline-offset-2 [&[aria-checked=true]_.thumb]:translate-x-4 [&[aria-checked=true]_.track]:border-black [&[aria-checked=true]_.track]:bg-black' -%}

	<div class="space-y-16">
		<div class="space-y-6" id="styleguide-ui-drawer">
