<section class="space-y-8" aria-labelledby="styleguide-icons">
	<header class="space-y-2">
		<p class="font-mono text-xs uppercase tracking-widest">
			{{- __('Assets', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-icons" class="text-2xl font-medium tracking-tight lg:text-3xl">{{- __('Icons', 'wp-cinquante-et-un') -}}</h2>
	</header>
	<ul class="grid grid-cols-4 gap-5 sm:grid-cols-6 lg:grid-cols-8">
		{%- for icon in icons -%}
			<li class="flex flex-col items-center gap-2">
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: icon,
							classes: ['size-6']
						},
						with_context = false
					)
				-}}
				<p class="font-mono text-xs tracking-widest text-center">
					{{ icon }}
				</p>
			</li>
		{%- endfor -%}
	</ul>
</section>

<section class="space-y-8" aria-labelledby="styleguide-image">
	<header class="space-y-2">
		<p class="font-mono text-xs uppercase tracking-widest">
			{{- __('Assets', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-image" class="text-2xl font-medium tracking-tight lg:text-3xl">
			{{- __('Image', 'wp-cinquante-et-un') -}}
		</h2>
		<p class="text-zinc-500 max-w-prose text-sm">
			{{-
				__(
					'image.html.twig accepts a WordPress attachment or a placeholder array: src, alt, width, height, and placeholder true. The starter ships src/img/svg/placeholder.svg so catalog blocks do not need a media library file.',
					'wp-cinquante-et-un'
				)
			-}}
		</p>
		<p class="font-mono text-xs text-zinc-400">
			components/image.html.twig
		</p>
	</header>
	<ul class="grid gap-8 sm:grid-cols-2">
		{%- for item in post.images -%}
			<li class="space-y-3">
				<div class="overflow-hidden rounded-xl border border-zinc-200 bg-zinc-100">
					{{-
						include(
							'components/image.html.twig',
							{
								image: item.image,
								classes: ['block w-full']
							},
							with_context = false
						)
					-}}
				</div>
				<p class="font-mono text-xs tracking-widest">
					{{ item.label }}
				</p>
				<p class="font-mono text-xs text-zinc-400">
					placeholder.svg · {{ item.image.width }} × {{ item.image.height }}
				</p>
			</li>
		{%- endfor -%}
	</ul>
</section>

<section class="space-y-8" aria-labelledby="styleguide-teasers">
	<header class="space-y-2">
		<p class="font-mono text-xs uppercase tracking-widest">
			{{- __('Components', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-teasers" class="text-2xl font-medium tracking-tight lg:text-3xl">
			{{- __('Teasers', 'wp-cinquante-et-un') -}}
		</h2>
		<p class="text-zinc-500 max-w-prose text-sm">
			{{-
				__(
					'Post cards used on the archive, latest posts, and hero. Dummy posts come from the page model.',
					'wp-cinquante-et-un'
				)
			-}}
		</p>
	</header>
	<div class="grid items-start gap-10 lg:grid-cols-2">
		<div class="space-y-4">
			<p class="font-mono text-xs tracking-widest">
				components/tease-post.html.twig
			</p>
			{{- include('components/tease-post.html.twig', { post: post.posts[0] }, with_context = false) -}}
		</div>
		<div class="space-y-4">
			<p class="font-mono text-xs tracking-widest">
				components/tease-post-mini.html.twig
			</p>
			{{- include('components/tease-post-mini.html.twig', { post: post.posts[1] }, with_context = false) -}}
		</div>
	</div>
</section>

<section class="space-y-8" aria-labelledby="styleguide-pagination">
	<header class="space-y-2">
		<p class="font-mono text-xs uppercase tracking-widest">
			{{- __('Components', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-pagination" class="text-2xl font-medium tracking-tight lg:text-3xl">
			{{- __('Pagination', 'wp-cinquante-et-un') -}}
		</h2>
		<p class="text-zinc-500 max-w-prose text-sm">
