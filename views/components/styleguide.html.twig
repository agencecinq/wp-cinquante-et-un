{#
 # Styleguide catalog: colors, type, radius, buttons, chips, icons, image, teasers, pagination, WYSIWYG, CINQ UI.
 #}

{%- set color_groups = [
	{
		title: __('White & black', 'wp-cinquante-et-un'),
		colors: [
			{ name: 'white', class: 'bg-white', token: '--color-white' },
			{ name: 'black', class: 'bg-black', token: '--color-black' }
		]
	},
	{
		title: __('Zinc', 'wp-cinquante-et-un'),
		colors: [
			{ name: 'zinc-50', class: 'bg-zinc-50', token: '--color-zinc-50' },
			{ name: 'zinc-100', class: 'bg-zinc-100', token: '--color-zinc-100' },
			{ name: 'zinc-200', class: 'bg-zinc-200', token: '--color-zinc-200' },
			{ name: 'zinc-400', class: 'bg-zinc-400', token: '--color-zinc-400' },
			{ name: 'zinc-500', class: 'bg-zinc-500', token: '--color-zinc-500' },
			{ name: 'zinc-800', class: 'bg-zinc-800', token: '--color-zinc-800' },
			{ name: 'zinc-950', class: 'bg-zinc-950', token: '--color-zinc-950' }
		]
	}
] -%}

{%- set titles = [
	{
		class: 'text-5xl font-medium tracking-tight lg:text-8xl',
		sample: __('A site that grows with you.', 'wp-cinquante-et-un')
	},
	{
		class: 'text-4xl font-medium tracking-tight lg:text-7xl',
		sample: __('Five commitments. None negotiable.', 'wp-cinquante-et-un')
	},
	{
		class: 'text-4xl font-medium tracking-tight lg:text-6xl',
		sample: __('Three ways to grow your site.', 'wp-cinquante-et-un')
	},
	{
		class: 'text-2xl font-medium tracking-tight lg:text-3xl',
		sample: __('Maintenance and evolutions', 'wp-cinquante-et-un')
	},
	{
		class: 'text-xl font-medium tracking-tight',
		sample: __('Shopify storefront', 'wp-cinquante-et-un')
	}
] -%}

{%- set texts = [
	{
		class: 'text-xl',
		sample: __('Your site is not an expense to write off every three years.', 'wp-cinquante-et-un')
	},
	{
		class: 'text-lg',
		sample: __(
			'It is an asset you build to last, and you evolve it with the company.',
			'wp-cinquante-et-un'
		)
	},
	{
		class: 'text-base',
		sample: __('Dedicated theme, D2C and B2B, CRM connected from day one.', 'wp-cinquante-et-un')
	},
	{
		class: 'text-sm',
		sample: __('Fast, maintainable WordPress brochure and editorial sites.', 'wp-cinquante-et-un')
	},
	{
		class: 'text-xs',
		sample: __('Paris, Tours, Marseille', 'wp-cinquante-et-un')
	}
] -%}

{%- set metas = [
	{
		class: 'font-mono text-xs uppercase tracking-widest',
		sample: __('What we do', 'wp-cinquante-et-un')
	},
	{
		class: 'font-mono text-xs tracking-widest',
		sample: __('01/03 - Work', 'wp-cinquante-et-un')
	},
	{
		class: 'font-mono text-sm font-medium tracking-wide',
		sample: __('Talk about your project', 'wp-cinquante-et-un')
	}
] -%}

{%- set radii = [
	{
		name: 'sm',
		class: 'rounded-sm'
	},
	{
		name: 'md',
		class: 'rounded-md'
	},
	{
		name: 'lg',
		class: 'rounded-lg'
	},
	{
		name: 'xl',
		class: 'rounded-xl'
	},
	{
		name: '2xl',
		class: 'rounded-2xl'
	},
	{
		name: '3xl',
		class: 'rounded-3xl'
	},
	{
		name: '4xl',
		class: 'rounded-4xl'
	},
	{
		name: 'full',
		class: 'rounded-full'
	}
] -%}

{%- set icons = [
	'arrow-left',
	'arrow-right',
	'bars',
	'bullet',
	'chevron-down',
	'chevron-left',
	'chevron-right',
	'envelope',
	'facebook',
	'globe',
	'instagram',
	'linkedin',
	'mark',
	'minus',
	'plus',
	'search',
	'times',
	'vimeo',
	'x',
	'youtube'
] -%}

<section class="space-y-8" aria-labelledby="styleguide-colors">
	<header class="space-y-2">
		<p class="font-mono text-xs uppercase tracking-widest">
			{{- __('Color', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-colors" class="text-2xl font-medium tracking-tight lg:text-3xl">{{- __('Palette', 'wp-cinquante-et-un') -}}</h2>
		<p class="text-zinc-500 max-w-prose text-sm">
			{{-
				__(
					'The starter uses Tailwind color utilities (bg-white, text-zinc-950, border-zinc-200). Override --color-zinc-* in theme.css for a project, or add a token if the palette does not map to the scale.',
					'wp-cinquante-et-un'
				)
			-}}
		</p>
	</header>
	<div class="space-y-10">
		{%- for group in color_groups -%}
			<div class="space-y-4">
				<p class="font-mono text-xs uppercase tracking-widest">
					{{ group.title }}
				</p>
				<ul class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5">
					{%- for color in group.colors -%}
						<li class="space-y-2">
							<div class="{{ color.class }} border-zinc-200 aspect-square rounded-xl border"></div>
							<p class="font-mono text-xs tracking-widest">
								{{ color.name }}
							</p>
							<p class="font-mono text-xs text-zinc-500">
								.{{ color.class }}
							</p>
							<p class="font-mono text-xs text-zinc-400">
								{{ color.token }}
							</p>
						</li>
					{%- endfor -%}
				</ul>
			</div>
		{%- endfor -%}
	</div>
</section>

<section class="space-y-8" aria-labelledby="styleguide-type">
	<header class="space-y-2">
		<p class="font-mono text-xs uppercase tracking-widest">
			{{- __('Typography', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-type" class="text-2xl font-medium tracking-tight lg:text-3xl">{{- __('Type scale', 'wp-cinquante-et-un') -}}</h2>
		<p class="text-zinc-500 max-w-prose text-sm">
			{{-
				__(
					'The starter uses Tailwind type utilities (text-xl, text-4xl lg:text-6xl, font-medium, font-mono). Override --text-* in theme.css for a project, or add a token if the ramp does not map to the scale.',
					'wp-cinquante-et-un'
				)
			-}}
		</p>
	</header>

	<div class="space-y-10">
		<div class="space-y-4">
			<p class="font-mono text-xs tracking-widest">
				{{- __('Titles', 'wp-cinquante-et-un') -}}
			</p>
			<ul class="divide-zinc-100 divide-y">
				{%- for item in titles -%}
					<li class="space-y-2 py-5">
						<p class="font-mono text-xs tracking-widest">
							.{{ item.class }}
						</p>
						<p class="{{ item.class }}">
							{{ item.sample }}
						</p>
					</li>
				{%- endfor -%}
			</ul>
		</div>

		<div class="space-y-4">
			<p class="font-mono text-xs tracking-widest">
				{{- __('Text', 'wp-cinquante-et-un') -}}
			</p>
			<ul class="divide-zinc-100 divide-y">
				{%- for item in texts -%}
					<li class="space-y-2 py-5">
						<p class="font-mono text-xs tracking-widest">
							.{{ item.class }}
						</p>
						<p class="{{ item.class }}">
							{{ item.sample }}
						</p>
					</li>
				{%- endfor -%}
			</ul>
		</div>

		<div class="space-y-4">
			<p class="font-mono text-xs tracking-widest">
				{{- __('Meta', 'wp-cinquante-et-un') -}}
			</p>
			<ul class="divide-zinc-100 divide-y">
				{%- for item in metas -%}
					<li class="space-y-2 py-5">
						<p class="font-mono text-xs tracking-widest">
							.{{ item.class }}
						</p>
						<p class="{{ item.class }}">
							{{ item.sample }}
						</p>
					</li>
				{%- endfor -%}
			</ul>
		</div>
	</div>
</section>

<section class="space-y-8" aria-labelledby="styleguide-radius">
	<header class="space-y-2">
		<p class="font-mono text-xs uppercase tracking-widest">
			{{- __('Radius', 'wp-cinquante-et-un') -}}
		</p>
		<h2 id="styleguide-radius" class="text-2xl font-medium tracking-tight lg:text-3xl">{{- __('Corners', 'wp-cinquante-et-un') -}}</h2>
		<p class="text-zinc-500 max-w-prose text-sm">
			{{-
				__(
					'The starter uses Tailwind radius utilities (rounded-md, rounded-2xl). Override --radius-* in theme.css for a project, or add a token if the scale does not map.',
					'wp-cinquante-et-un'
				)
			-}}
		</p>
	</header>
	<ul class="flex flex-wrap items-end gap-5">
		{%- for radius in radii -%}
			<li class="space-y-2 text-center">
				<div class="bg-zinc-950 size-20 {{ radius.class }}"></div>
				<p class="font-mono text-xs tracking-widest">
					.{{ radius.class }}
				</p>
			</li>
		{%- endfor -%}
	</ul>
</section>

