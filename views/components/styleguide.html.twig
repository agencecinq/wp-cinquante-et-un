				<h3 class="text-xl font-semibold">
					{{- __('Drawer', 'wp-cinquante-et-un') -}}
				</h3>
				<p class="text-gray-500 max-w-prose text-sm">
					{{-
						__(
							'Off-canvas panel. Pair cinq-drawer with cinq-drawer-button.',
							'wp-cinquante-et-un'
						)
					-}}
				</p>
				<p class="font-mono text-xs text-gray-500">
					@agencecinq/drawer · components/drawer.html.twig
				</p>
			</header>
			<div class="border border-black p-6">
				<cinq-drawer-button class="inline-block">
					{{-
						include(
							'components/button.html.twig',
							{
								title: __('Open drawer', 'wp-cinquante-et-un'),
								attributes: {
									'aria-controls': 'styleguide-drawer'
								}
							},
							with_context = false
						)
					-}}
				</cinq-drawer-button>
				{% embed 'components/drawer.html.twig'
					with {
						id: 'styleguide-drawer',
						direction: 'from-right',
						aria_label: __('Styleguide drawer', 'wp-cinquante-et-un')
					}
				%}
					{% block content %}
						<div class="space-y-3 p-5">
							<p class="text-xl font-semibold">
								{{- __('Drawer', 'wp-cinquante-et-un') -}}
							</p>
							<p class="text-sm text-gray-600">
								{{-
									__(
										'Slide-over navigation or filters. Close with Escape or the backdrop.',
										'wp-cinquante-et-un'
									)
								-}}
							</p>
						</div>
					{% endblock %}
				{% endembed %}
			</div>
		</div>

		<div class="space-y-6" id="styleguide-ui-modal">
			<header class="space-y-2">
				<h3 class="text-xl font-semibold">
					{{- __('Modal', 'wp-cinquante-et-un') -}}
				</h3>
				<p class="text-gray-500 max-w-prose text-sm">
					{{-
						__('Native dialog. Pair cinq-modal with cinq-modal-button.', 'wp-cinquante-et-un')
					-}}
				</p>
				<p class="font-mono text-xs text-gray-500">
					@agencecinq/modal · components/modal.html.twig
				</p>
			</header>
			<div class="border border-black p-6">
				<cinq-modal-button class="inline-block">
					{{-
						include(
							'components/button.html.twig',
							{
								title: __('Open modal', 'wp-cinquante-et-un'),
								attributes: {
									'aria-controls': 'styleguide-modal',
									'aria-pressed': 'false'
								}
							},
							with_context = false
						)
					-}}
				</cinq-modal-button>
				{% embed 'components/modal.html.twig'
					with {
						id: 'styleguide-modal'
					}
				%}
					{% block content %}
						<div class="space-y-3">
							<p class="text-xl font-semibold">
								{{- __('Modal', 'wp-cinquante-et-un') -}}
							</p>
							<p class="text-sm text-gray-600">
								{{-
									__(
										'Focus trap and backdrop dismiss. Use for confirmations or compact forms.',
										'wp-cinquante-et-un'
									)
								-}}
							</p>
						</div>
					{% endblock %}
				{% endembed %}
			</div>
		</div>

		<div class="space-y-6" id="styleguide-ui-tabs">
			<header class="space-y-2">
				<h3 class="text-xl font-semibold">
					{{- __('Tabs', 'wp-cinquante-et-un') -}}
				</h3>
				<p class="text-gray-500 max-w-prose text-sm">
					{{-
						__(
							'Keyboard navigable tablist. Active tab mirrors the secondary button pattern.',
							'wp-cinquante-et-un'
						)
					-}}
				</p>
				<p class="font-mono text-xs text-gray-500">
					@agencecinq/tabs
				</p>
			</header>
			<div class="border border-black p-6">
				<cinq-tabs class="block space-y-6" data-hash="false">
					<div
						class="flex flex-wrap gap-2"
						role="tablist"
						aria-label="{{ __('Styleguide tabs', 'wp-cinquante-et-un') }}"
					>
						<button
							type="button"
							class="is-active {{ tab_classes }}"
							role="tab"
							aria-selected="true"
							aria-controls="styleguide-tab-one"
							id="styleguide-tab-btn-one"
						>
							{{- __('One', 'wp-cinquante-et-un') -}}
						</button>
						<button
							type="button"
							class="{{ tab_classes }}"
