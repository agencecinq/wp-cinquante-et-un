						</div>
					</div>
				</cinq-accordion>
			</div>

			<div class="space-y-4">
				<p class="font-mono text-xs tracking-widest">
					@agencecinq/disclosure-button
				</p>
				<cinq-disclosure-button class="block">
					{{-
						include(
							'components/button.html.twig',
							{
								title: __('Show more', 'wp-cinquante-et-un'),
								attributes: {
									'aria-expanded': 'false',
									'aria-controls': 'styleguide-disclosure'
								}
							},
							with_context = false
						)
					-}}
				</cinq-disclosure-button>
				<div class="mt-3 text-sm" id="styleguide-disclosure" hidden>
					{{- __('Hidden until the disclosure button opens it.', 'wp-cinquante-et-un') -}}
				</div>
			</div>

			<div class="space-y-4">
				<p class="font-mono text-xs tracking-widest">
					@agencecinq/switch
				</p>
				<div
					class="flex flex-wrap items-center gap-6"
					role="group"
					aria-label="{{ __('Switches', 'wp-cinquante-et-un') }}"
				>
					<cinq-switch
						class="inline-flex cursor-pointer items-center gap-3 font-mono text-sm font-medium tracking-wide focus-visible:outline focus-visible:outline-offset-2 [&[aria-checked=true]_.thumb]:translate-x-4 [&[aria-checked=true]_.track]:bg-zinc-950"
						role="switch"
						aria-checked="false"
						tabindex="0"
					>
						<span>{{- __('Notifications', 'wp-cinquante-et-un') -}}</span>
						<span class="track relative block h-6 w-10 rounded-full bg-zinc-200" aria-hidden="true">
							<span
								class="thumb absolute top-0.5 left-0.5 block size-5 rounded-full bg-white transition-transform"
							>

							</span>
						</span>
						<div hidden>
							<input type="checkbox" tabindex="-1" aria-hidden="true" />
						</div>
					</cinq-switch>
					<cinq-switch
						class="inline-flex cursor-pointer items-center gap-3 font-mono text-sm font-medium tracking-wide opacity-50 [&[aria-checked=true]_.thumb]:translate-x-4 [&[aria-checked=true]_.track]:bg-zinc-950"
						role="switch"
						aria-checked="false"
						disabled
						aria-disabled="true"
						tabindex="-1"
					>
						<span>{{- __('Disabled', 'wp-cinquante-et-un') -}}</span>
						<span class="track relative block h-6 w-10 rounded-full bg-zinc-200" aria-hidden="true">
							<span
								class="thumb absolute top-0.5 left-0.5 block size-5 rounded-full bg-white transition-transform"
							>

							</span>
						</span>
						<div hidden>
							<input type="checkbox" tabindex="-1" aria-hidden="true" disabled />
						</div>
					</cinq-switch>
				</div>
			</div>

			<div class="space-y-4">
				<p class="font-mono text-xs tracking-widest">
					@agencecinq/spinbutton
				</p>
				<cinq-spinbutton
					class="inline-flex w-fit items-center gap-2 rounded-md border border-zinc-200 bg-zinc-50 p-1 focus-within:ring-2 focus-within:ring-zinc-950"
				>
					<button
						class="grid size-8 place-items-center rounded-sm bg-white hover:bg-zinc-100 disabled:cursor-not-allowed disabled:opacity-40"
						name="decrease"
						type="button"
						aria-label="{{ __('Decrease', 'wp-cinquante-et-un') }}"
						tabindex="-1"
					>
						{{-
							include(
								'svg/use.html.twig',
								{
									icon: 'minus',
									classes: ['size-4']
								},
								with_context = false
							)
						-}}
					</button>
					<input
						class="w-14 bg-transparent text-center font-mono text-sm font-medium tracking-wide focus:outline-none"
						type="number"
						aria-label="{{ __('Quantity', 'wp-cinquante-et-un') }}"
						aria-valuemin="0"
						aria-valuemax="10"
						aria-valuenow="1"
						value="1"
					/>
					<button
						class="grid size-8 place-items-center rounded-sm bg-white hover:bg-zinc-100 disabled:cursor-not-allowed disabled:opacity-40"
						name="increase"
						type="button"
						aria-label="{{ __('Increase', 'wp-cinquante-et-un') }}"
						tabindex="-1"
					>
						{{-
							include(
								'svg/use.html.twig',
								{
									icon: 'plus',
									classes: ['size-4']
								},
								with_context = false
							)
						-}}
					</button>
				</cinq-spinbutton>
			</div>

			<div class="space-y-4">
				<p class="font-mono text-xs tracking-widest">
					@agencecinq/combobox
				</p>
				<label class="block font-mono text-xs tracking-widest" for="styleguide-city">
					{{- __('City', 'wp-cinquante-et-un') -}}
				</label>
				<cinq-combobox
					id="styleguide-city-combobox"
					class="relative mt-2 flex max-w-xs"
					data-open-on-empty="true"
					data-autoselect="true"
				>
					<input
						class="rounded-l-6 min-w-0 flex-1 border border-zinc-950 px-3 py-2 font-mono text-sm font-medium tracking-wide"
						id="styleguide-city"
						type="text"
						role="combobox"
						aria-autocomplete="list"
						aria-expanded="false"
						aria-controls="styleguide-city-listbox"
						autocomplete="off"
					/>
					<button
						class="rounded-r-6 -ml-px flex size-10 shrink-0 items-center justify-center border border-zinc-950"
						type="button"
						tabindex="-1"
						aria-label="{{ __('Cities', 'wp-cinquante-et-un') }}"
						aria-controls="styleguide-city-listbox"
						aria-expanded="false"
					>
						{{-
							include(
								'svg/use.html.twig',
								{
									icon: 'chevron-down',
									classes: ['size-4']
								},
								with_context = false
							)
						-}}
					</button>
					<ul
						class="z-2 rounded-md border border-zinc-200 bg-white **:[[role=option]]:cursor-pointer **:[[role=option]]:px-3 **:[[role=option]]:py-2 **:[[role=option][aria-selected=true]]:bg-zinc-950 **:[[role=option][aria-selected=true]]:text-white"
						id="styleguide-city-listbox"
						role="listbox"
						aria-label="{{ __('Cities', 'wp-cinquante-et-un') }}"
						hidden
					></ul>
				</cinq-combobox>
			</div>
		</div>
	</section>
</div>
