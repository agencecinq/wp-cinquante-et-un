{#
 # Components: Tease Post
 #
 # Schema.org: BlogPosting (headline, image, description, url, datePublished, dateModified, author).
 # A11y: Single main link per card with aria-label; heading; image alt from thumbnail.
 #
 # @param object post Timber post (or dummy with the same shape).
 # @param array classes Extra CSS classes.
 #}

{%- set excerpt =
	post.excerpt({
		words: 24,
		read_more: ''
	})
-%}

<article
	itemscope
	itemtype="https://schema.org/BlogPosting"
	class="{{ html_classes('flex flex-col gap-4', classes | default([]) | join(' ')) }}"
>
	<div class="relative aspect-3/2 overflow-hidden border border-black bg-gray-100">
		<a
			href="{{- post.link -}}"
			itemprop="url"
			class="absolute inset-0 z-2 size-full"
			aria-label="{{ __('Read: %s', 'wp-cinquante-et-un') | format(post.title) }}"
			tabindex="-1"
		>
			<span class="sr-only">{{- __('Read', 'wp-cinquante-et-un') -}}</span>
		</a>
		{{-
			include(
				'components/image.html.twig',
				{
					image: post.thumbnail,
					classes: ['relative z-1 size-full object-cover object-center'],
					attributes: {
						itemprop: 'image'
					}
				}
			)
		-}}
	</div>

	<div class="flex flex-col gap-3">
		<div class="flex items-center gap-3">
			{%- if (post.categories | length) > 0 -%}
				{%- for category in post.categories | slice(0, 1) -%}
					{{-
						include(
							'components/tag.html.twig',
							{
								title: category.name,
								attributes: {
									itemprop: 'articleSection'
								}
							}
						)
					-}}
				{%- endfor -%}
			{%- endif -%}

			<time class="text-xs text-gray-500" datetime="{{ post.date('c') }}" itemprop="datePublished">
				{{- post.date -}}
			</time>
		</div>

		<h3 class="text-xl font-semibold" itemprop="headline">
			<a href="{{ post.link }}" itemprop="url">{{- post.title -}}</a>
		</h3>

		{%- if excerpt | striptags | trim -%}
			<p class="line-clamp-2 text-sm text-gray-600" itemprop="description">
				{{- excerpt -}}
			</p>
		{%- endif -%}

		{{-
			include(
				'components/text-link.html.twig',
				{
					title: __('Read more', 'wp-cinquante-et-un'),
					url: post.link
				},
				with_context = false
			)
		-}}
	</div>

	<meta itemprop="dateModified" content="{{ post.modified('c') }}" />
	<meta itemprop="author" content="{{ post.author.name | default('WPCinquanteEtUn') | e('html_attr') }}" />
</article>
