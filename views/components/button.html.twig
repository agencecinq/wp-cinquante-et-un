{#
 # Components: Button
 #
 # @param string title The button text.
 # @param string url Optional. Renders an <a> when set.
 # @param string target '_self' or '_blank'. Links only.
 # @param string variant 'primary', 'secondary' or 'tertiary'.
 # @param bool disabled
 # @param string icon Optional sprite icon name.
 # @param string type Button type when not a link. Default 'button'.
 # @param attributes Extra HTML attributes.
 # @param array classes Extra CSS classes.
 #}

{%- set variant = variant | default( 'primary' ) -%}
{%- set disabled = disabled | default( false ) -%}
{%- set icon = icon | default( '' ) -%}

{%- set base_classes = [
	classes | default( [] ) | join( ' ' ),
	'button',
	'button--' ~ variant,
] -%}

{%- if icon_html is defined -%}
	{% set icon_html = icon_html %}
{%- elseif icon is defined and icon is not empty -%}
	{%- set icon_html -%}
		{{- include( 'svg/use.html.twig', { classes: [ 'size-4' ], icon: icon } ) -}}
	{%- endset -%}
{%- endif -%}

{%- if title -%}
	<{{ url ? 'a' : 'button' }}
		{{ url ? "href=\"#{url}\"" : "type=\"#{ type | default( 'button' ) }\"" }}
		{{ url and target ? "target=\"#{target}\"" : '' }}
		{{ url and target == '_blank' ? 'rel="noopener noreferrer"' : '' }}
		class="{{ html_classes( base_classes | join( ' ' ) ) }}"
		{{ disabled ? 'disabled' }}
		{{ attributes ? attributes | map( ( value, key ) => value == '' ? key : "#{key}=\"#{value}\"" ) | join( ' ' ) | raw }}
	>
		{%- if icon_html is not empty -%}
			<span class="size-4 shrink-0" aria-hidden="true">
				{{- icon_html -}}
			</span>
		{%- endif -%}
		<span>{{- title -}}</span>
	</{{ url ? 'a' : 'button' }}>
{%- endif -%}
