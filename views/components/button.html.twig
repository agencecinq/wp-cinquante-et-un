{#
 # Components: Button
 #
 # @param string title The button text.
 # @param string url Optional. Renders an <a> when set. A mailto: address and
 #   the button text are obfuscated against harvesters (antispambot).
 # @param string target '_self' or '_blank'. Links only.
 # @param string variant 'primary', 'secondary' or 'tertiary'.
 # @param bool disabled
 # @param string icon Optional sprite icon name.
 # @param string type Button type when not a link. Default 'button'.
 # @param attributes Extra HTML attributes.
 # @param array classes Extra CSS classes.
 #}

{%- set variant = variant | default( 'primary' ) -%}
{%- set disabled = disabled | default( false ) -%}
{%- set icon = icon | default( '' ) -%}
{%- set mailto = url starts with 'mailto:' -%}

{%- set base_classes = [ classes | default( [] ) | join( ' ' ), 'button', 'button--' ~ variant ] -%}

{%- if title -%}
	<{{ url ? 'a' : 'button' }}
		{{ html_attr( url and not mailto ? { href: url } ) }}
		{{ url | mailto_href }}
		{{ html_attr( not url ? { type: type | default( 'button' ) } ) }}
		{{ html_attr( url and target ? { target: target } ) }}
		{{ html_attr( url and target == '_blank' ? { rel: 'noopener noreferrer' } ) }}
		class="{{ html_classes( base_classes | join( ' ' ) ) }}"
		{{ html_attr( disabled ? { disabled: true } ) }}
		{{ html_attr( attributes ) }}
	>
		{%- if icon -%}
			<span class="button__icon" aria-hidden="true">
				{{- include( 'svg/use.html.twig', { icon: icon }, with_context: false ) -}}
			</span>
		{%- endif -%}
		<span class="button__label">{{- mailto ? title | antispambot : title -}}</span>
	</{{ url ? 'a' : 'button' }}>
{%- endif -%}
