{#
 # Components: Pagination
 #
 # Current page is inverse (black fill). Arrows hide below lg.
 #
 # @param {object} pagination
 # @param {string} [label] Accessible name for the nav. Defaults to Pagination.
 #}

{%- if (pagination.pages | length) > 1 -%}
	<nav
		role="navigation"
		aria-label="{{ label | default(__('Pagination', 'wp-cinquante-et-un')) }}"
		class="{{ html_classes('inline-flex items-center gap-2.5 text-sm', classes | default([]) | join(' ')) }}"
	>
		{% if pagination.prev %}
			<a
				href="{{ pagination.prev.link }}{{ anchor | default('') }}"
				class="hidden size-14 shrink-0 items-center justify-center lg:flex"
				aria-label="{{ __('Previous', 'wp-cinquante-et-un') }}"
			>
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'arrow-left',
							classes: ['size-3.5']
						}
					)
				-}}
			</a>
		{% else %}
			<span
				class="hidden size-14 shrink-0 items-center justify-center opacity-30 lg:flex"
				aria-hidden="true"
			>
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'arrow-left',
							classes: ['size-3.5']
						}
					)
				-}}
			</span>
		{% endif %}

		<ul class="flex flex-wrap items-center justify-center gap-2.5">
			{% for page in pagination.pages %}
				<li>
					{% if page.link %}
						<a
							href="{{ page.link }}{{ anchor | default('') }}"
							class="{{ page.class }} flex size-14 items-center justify-center"
						>
							{{- page.title -}}
						</a>
					{% else %}
						<span
							class="{{
							html_classes(
								'flex size-14 items-center justify-center',
								page.class,
								'current' in (page.class | split(' ')) ? 'bg-black text-white' : ''
							)
							}}"
							{{ 'current' in (page.class | split(' ')) ? 'aria-current="page"' : '' }}
						>
							{{- page.title -}}
						</span>
					{% endif %}
				</li>
			{% endfor %}
		</ul>

		{% if pagination.next %}
			<a
				href="{{ pagination.next.link }}{{ anchor | default('') }}"
				class="hidden size-14 shrink-0 items-center justify-center lg:flex"
				aria-label="{{ __('Next', 'wp-cinquante-et-un') }}"
			>
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'arrow-right',
							classes: ['size-3.5']
						}
					)
				-}}
			</a>
		{% else %}
			<span
				class="hidden size-14 shrink-0 items-center justify-center opacity-30 lg:flex"
				aria-hidden="true"
			>
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'arrow-right',
							classes: ['size-3.5']
						}
					)
				-}}
			</span>
		{% endif %}
	</nav>
{%- endif -%}
