{#
 # Components: Pagination
 #
 # @param {object} pagination
 # @param {string} [label] Accessible name for the nav. Defaults to Pagination.
 #}

{%- if (pagination.pages | length) > 0 -%}
	<nav
		role="navigation"
		aria-label="{{ label | default(__('Pagination', 'wp-cinquante-et-un')) }}"
		class="{{ html_classes('font-mono text-xs tracking-widest inline-flex items-center gap-2', classes | default([]) | join(' ')) }}"
	>
		{% if pagination.prev %}
			<a
				href="{{ pagination.prev.link }}{{ anchor | default('') }}"
				class="hover:border-zinc-950 hover:bg-zinc-950 hover:text-white border-zinc-200 flex size-10 shrink-0 items-center justify-center rounded-full border transition-colors"
				aria-label="{{ __('Previous', 'wp-cinquante-et-un') }}"
			>
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'arrow-left',
							classes: ['size-4']
						}
					)
				-}}
			</a>
		{% else %}
			<span
				class="border-zinc-200 flex size-10 shrink-0 cursor-not-allowed items-center justify-center rounded-full border opacity-50"
			>
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'arrow-left',
							classes: ['size-4']
						}
					)
				-}}
			</span>
		{% endif %}

		<ul class="flex flex-wrap justify-center">
			{% for page in pagination.pages %}
				<li>
					{% if page.link %}
						<a
							href="{{ page.link }}{{ anchor | default('') }}"
							class="{{ page.class }} hover:bg-zinc-950 hover:text-white flex size-10 items-center justify-center rounded-full transition-colors"
						>
							{{- page.title -}}
						</a>
					{% else %}
						<span
							class="{{
							html_classes(
								'flex size-10 items-center justify-center rounded-full',
								page.class,
								'current' in (page.class | split(' ')) ? 'bg-zinc-950 text-white' : ''
							)
							}}"
							{{ 'current' in (page.class | split(' ')) ? 'aria-current="page"' : '' }}
						>
							{{- page.title -}}
						</span>
					{% endif %}
				</li>
			{% endfor %}
		</ul>

		{% if pagination.next %}
			<a
				href="{{ pagination.next.link }}{{ anchor | default('') }}"
				class="hover:border-zinc-950 hover:bg-zinc-950 hover:text-white border-zinc-200 flex size-10 shrink-0 items-center justify-center rounded-full border transition-colors"
				aria-label="{{ __('Next', 'wp-cinquante-et-un') }}"
			>
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'arrow-right',
							classes: ['size-4']
						}
					)
				-}}
			</a>
		{% else %}
			<span
				class="border-zinc-200 flex size-10 shrink-0 cursor-not-allowed items-center justify-center rounded-full border opacity-50"
			>
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'arrow-right',
							classes: ['size-4']
						}
					)
				-}}
			</span>
		{% endif %}
	</nav>
{%- endif -%}