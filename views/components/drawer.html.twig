{#
 # Components: Drawer
 #
 # Native <dialog> in `cinq-drawer` (@agencecinq/drawer 9). Open it with a
 # `commandfor="{id}" command="show-modal"` button (modal), or
 # `command="toggle-popover"` (non-modal); close buttons inside take
 # `command="request-close"` (modal) or `command="hide-popover"`.
 #
 # @param {string} id - The dialog ID. Required.
 # @param {string} [direction] - 'from-left', 'from-right' or 'from-bottom'. Default is '' (fade).
 # @param {string} [classes] - Additional classes on the `cinq-drawer` host. Optional.
 # @param {string} [panel_classes] - Extra classes for the dialog panel. Optional.
 # @param {string} [margin_top] - Top offset of the drawer, e.g. to leave a header visible. Default is '0rem'.
 # @param {string} [aria_label] - Accessible name for the dialog (required for accessibility). Optional.
 # @param {boolean} [modal] - false keeps the page (header included) usable: the dialog is a popover and a scrim dims the page. Default is true.
 #
 # @example
 # {% embed 'components/drawer.html.twig' with { id: 'drawer1', direction: 'from-left', aria_label: 'Menu' } %}
 # 	{% block content %}…{% endblock %}
 # {% endembed %}
 #}

{% set direction = direction | default( '' ) %}
{% set margin_top = margin_top | default( '0rem' ) %}
{% set modal = modal ?? true %}
{% set translate = 'inset-x-0 bottom-0 w-auto opacity-0 open:opacity-100 starting:open:opacity-0' %}

{% if direction == 'from-left' %}
	{% set translate =
		'bottom-0 left-0 right-auto w-148.75 -translate-x-full open:translate-x-0 starting:open:-translate-x-full'
	%}
{% endif %}

{% if direction == 'from-bottom' %}
	{% set translate =
		'inset-x-0 bottom-0 top-auto w-auto translate-y-full open:translate-y-0 starting:open:translate-y-full'
	%}
{% endif %}

{% if direction == 'from-right' %}
	{% set translate =
		'bottom-0 right-0 left-auto w-97.5 translate-x-full open:translate-x-0 starting:open:translate-x-full'
	%}
{% endif %}

<cinq-drawer class="{{ html_classes( 'contents', classes | default( '' ) ) }}">
	{#- A popover gets a ::backdrop over the whole page too: only the modal drawer paints it, the non-modal one has its own scrim, over the whole page but under the fixed header, which stays bright and usable. -#}
	<dialog
		id="{{ id }}"
		{{ html_attr( modal ? { closedby: 'any' } : { popover: true } ) }}
		{{ html_attr( aria_label ? { 'aria-label': aria_label } ) }}
		class="{{
			html_classes(
				'peer fixed m-0 h-auto max-h-none max-w-full border-0 p-0',
				'transition-[translate,opacity,overlay,display] transition-discrete duration-300 ease-drawer',
				modal
					? 'backdrop:bg-overlay-scrim/30 backdrop:opacity-0 backdrop:transition-[opacity,overlay,display] backdrop:transition-discrete backdrop:duration-300 open:backdrop:opacity-100 starting:open:backdrop:opacity-0'
					: 'backdrop:bg-transparent',
				translate,
				'overflow-hidden bg-page text-primary',
				panel_classes | default( '' )
			)
		}}"
		style="{{ direction == 'from-bottom'
			? 'max-height: calc(100% - ' ~ margin_top ~ ');'
			: 'top: ' ~ margin_top ~ ';' }}"
	>
		<div class="scrollbar-hidden h-full overflow-y-auto scroll-smooth">
			{%- block content -%}{%- endblock -%}
		</div>
	</dialog>

	{%- if not modal -%}
		{#- The scrim dims the whole page under the fixed header (z-40), which stays bright and usable; a press on it closes the drawer (light dismiss). -#}
		<div
			class="pointer-events-none fixed inset-0 z-30 bg-overlay-scrim/30 opacity-0 transition-opacity duration-300 ease-drawer peer-open:pointer-events-auto peer-open:opacity-100"
			aria-hidden="true"
		></div>
	{%- endif -%}
</cinq-drawer>
