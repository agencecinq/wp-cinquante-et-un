{#
 # Components: Accordion Group
 #
 # Native details/summary. First item open by default.
 #
 # @param array items Panels with question and answer.
 # @param array classes Extra CSS classes.
 #}

{%- if items | length -%}
	<div class="{{ html_classes( classes | default([]) | join(' ') ) }}">
		{%- for item in items -%}
			<details
				class="group border-t border-gray-200 last:border-b"
				{{ loop.first ? 'open' }}
			>
				<summary
					class="flex cursor-pointer list-none items-center justify-between gap-4 py-6 text-sm font-semibold [&::-webkit-details-marker]:hidden"
				>
					<span class="min-w-0 flex-1">{{- item.question -}}</span>
					<span
						class="relative flex size-8 shrink-0 items-center justify-center bg-gray-100"
						aria-hidden="true"
					>
						<span class="group-open:hidden">
							{{- include('svg/use.html.twig', { classes: ['size-3'], icon: 'plus' }) -}}
						</span>
						<span class="hidden group-open:block">
							{{- include('svg/use.html.twig', { classes: ['size-3'], icon: 'minus' }) -}}
						</span>
					</span>
				</summary>
				<div class="wysiwyg max-w-3xl pb-6 text-sm">
					{{- item.answer | raw -}}
				</div>
			</details>
		{%- endfor -%}
	</div>
{%- endif -%}
