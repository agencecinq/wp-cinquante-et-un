{#
 # Components: Accordion Group
 #
 # FAQ-style accordion (CINQ Design System). First item open by default.
 #
 # @param classes (array) - The classes to apply to the accordion.
 # @param accordions (array) - The accordions to display.
 #
 # @example
 # {{- include('components/accordion-group.html.twig', { classes: [ 'bg-card rounded-20 px-3.5 py-7.5 lg:px-12.75 lg:py-9.25' ], accordions: block.content.accordions }) -}}
 #}

{%- if accordions | length > 1 -%}
	<cinq-accordion
		class="{{
		html_classes(
			classes | default([]) | join(' '),
			'divide-border-subtle block divide-y'
		)
		}}"
		data-hash="false"
	>
		{%- for accordion in accordions -%}
			{%- set id = (accordion.header | sanitize) ~ '-' ~ loop.index0 -%}
			{%- set is_open = loop.first -%}
			<div
				class="py-6 data-[open=true]:flex data-[open=true]:flex-col data-[open=true]:gap-4"
				data-panel
				data-open="{{ is_open ? 'true' : 'false' }}"
				data-deselect="true"
			>
				<button
					type="button"
					class="title-md flex w-full items-center justify-between gap-6 text-left in-data-[open=true]:text-accent"
					data-header
					id="{{ id }}-header"
					aria-expanded="{{ is_open ? 'true' : 'false' }}"
					aria-controls="{{ id }}-body"
				>
					<span class="min-w-0 flex-1">{{- accordion.header -}}</span>
					<span class="title-md shrink-0 text-subtle in-data-[open=true]:hidden" aria-hidden="true">+</span>
					<span class="title-md hidden shrink-0 in-data-[open=true]:inline" aria-hidden="true">−</span>
				</button>
				<div
					id="{{ id }}-body"
					role="region"
					aria-labelledby="{{ id }}-header"
					{{ is_open ? '' : 'hidden' }}
				>
					<div class="text-sm text-muted" data-inner>
						{{ accordion.content }}
					</div>
				</div>
			</div>
		{%- endfor -%}
	</cinq-accordion>
{%- endif -%}
