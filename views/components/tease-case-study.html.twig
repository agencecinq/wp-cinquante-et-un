{#
 # Components: Tease Case Study
 #
 # @param array item Case study card data.
 #}

<article class="flex flex-col gap-4">
	<div class="relative aspect-4/3 overflow-hidden border border-black bg-gray-100">
		{%- if item.url -%}
			<a
				href="{{ item.url }}"
				class="absolute inset-0 z-2"
				aria-label="{{ item.title }}"
				tabindex="-1"
			></a>
		{%- endif -%}
		{{-
			include(
				'components/image.html.twig',
				{
					image: item.image,
					classes: ['relative z-1 size-full object-cover object-center']
				}
			)
		-}}
	</div>

	<div class="space-y-3">
		<div class="flex items-center gap-3">
			{{- include('components/tag.html.twig', { title: item.sector }) -}}
			{%- if item.client -%}
				<p class="text-xs font-medium">{{- item.client -}}</p>
			{%- endif -%}
		</div>

		{%- if item.title -%}
			<h3 class="text-xl font-semibold">
				{%- if item.url -%}
					<a href="{{ item.url }}">{{- item.title -}}</a>
				{%- else -%}
					{{- item.title -}}
				{%- endif -%}
			</h3>
		{%- endif -%}

		{%- if item.result_value or item.result_label -%}
			<p class="flex items-baseline gap-2">
				{%- if item.result_value -%}
					<span class="text-2xl font-semibold">{{- item.result_value -}}</span>
				{%- endif -%}
				{%- if item.result_label -%}
					<span class="text-sm text-gray-600">{{- item.result_label -}}</span>
				{%- endif -%}
			</p>
		{%- endif -%}
	</div>
</article>
