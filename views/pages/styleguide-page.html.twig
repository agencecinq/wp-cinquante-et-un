{#
 # Styleguide page
 #
 # Assign the "Styleguide" page template in WordPress. No ACF blocks required.
 #
 # @package WPCinquanteEtUn
 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}

{% extends 'index.html.twig' %}

{%- block content -%}
	<main id="content" role="main">
		<div class="container space-y-20 pt-40 pb-section-lg lg:space-y-30">
			<header class="space-y-3">
				<p class="subtitle">
					{{- __('Foundations', 'wp-cinquante-et-un') -}}
				</p>
				<h1 class="text-4xl font-semibold">
					{{- post.title | default(__('Styleguide', 'wp-cinquante-et-un')) -}}
				</h1>
				<p class="text-gray-500 max-w-prose text-lg">
					{{-
						__(
							'Tokens, UI components, and kernel blocks shipped with the starter. Assign this page template; the catalog is rendered from Twig, not from ACF.',
							'wp-cinquante-et-un'
						)
					-}}
				</p>
			</header>

			<nav aria-label="{{ __('Styleguide', 'wp-cinquante-et-un') }}" class="space-y-6">
				{%- for group in post.toc -%}
					<div class="space-y-3">
						<p class="subtitle">
							{{ group.title }}
						</p>
						<ul class="flex flex-wrap gap-x-5 gap-y-2">
							{%- for item in group.items -%}
								<li itemscope itemtype="https://schema.org/SiteNavigationElement">
									<a
										href="{{ item.href }}"
										itemprop="url"
										class="text-xs underline underline-offset-2"
									>
										<span itemprop="name">{{ item.title }}</span>
									</a>
								</li>
							{%- endfor -%}
						</ul>
					</div>
				{%- endfor -%}
			</nav>

			{{- include('components/styleguide.html.twig') -}}
		</div>

		<section class="space-y-20 pb-section-xl pt-section-lg lg:space-y-30" aria-labelledby="styleguide-blocks">
			<header class="container space-y-3">
				<p class="subtitle">
					{{- __('Blocks', 'wp-cinquante-et-un') -}}
				</p>
				<h2 id="styleguide-blocks" class="text-4xl font-semibold">
					{{- __('Kernel layouts', 'wp-cinquante-et-un') -}}
				</h2>
				<p class="text-gray-500 max-w-prose text-lg">
					{{-
						__(
							'Kernel ACF layouts rendered with the same Twig as production. Blocks with variants expose a switcher; dummy data lives in includes/Models/Styleguide/.',
							'wp-cinquante-et-un'
						)
					-}}
				</p>
			</header>

			{%- for item in post.blocks -%}
				{{- include('components/styleguide-layout-block.html.twig', { item: item }) -}}
			{%- endfor -%}
		</section>
	</main>
{%- endblock -%}
