		"dev": "vite",
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"views/**/*.twig\" \"src/**/*.{css,ts,js}\"",
		"format:check": "prettier --check \"views/**/*.twig\" \"src/**/*.{css,ts,js}\""
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
