	"bugs": {
		"url": "https://github.com/agencecinq/wp-cinquante-et-un/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/agencecinq/wp-cinquante-et-un.git"
	},
	"license": "GPL-2.0-or-later",
	"author": "CINQ <contact@agencecinq.com> (https://agencecinq.com)",
	"main": "dist/main.js",
